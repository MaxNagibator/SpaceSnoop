<UserControl x:Class="SpaceSnoop.Wpf.Views.Docker.DockerCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Docker"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DockerViewModel}">
    <UserControl.Resources>
        <Style x:Key="Docker.SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="{DynamicResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
        </Style>
        <Style x:Key="Docker.ColumnHeader"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
        </Style>
        <Style x:Key="Docker.ActionButtonContent"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="15" />
            <Setter Property="Height"
                    Value="15" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,2">
        <StackPanel>
            <TextBlock Text="Очистка"
                       Style="{StaticResource Docker.SectionTitle}" />
            <TextBlock Text="Операции Docker безвозвратны – мимо корзины. Каждая спросит подтверждение."
                       Style="{StaticResource TextBlock.Subtle}"
                       Foreground="{DynamicResource Fg.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <TextBlock Text="Безопасно"
                       Style="{StaticResource Docker.ColumnHeader}"
                       Margin="0,14,0,6" />
            <WrapPanel>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneBuildCacheCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker builder prune">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Hammer}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="Кэш сборки"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneDanglingImagesCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker image prune">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Image}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="Висячие образы"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneStoppedContainersCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker container prune">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Box}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="Остановленные контейнеры"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="Агрессивно – безвозвратно"
                       Style="{StaticResource Docker.ColumnHeader}"
                       Foreground="{DynamicResource State.Warning}"
                       Margin="0,10,0,6" />
            <WrapPanel>
                <Button Style="{StaticResource Button.Destructive}"
                        Command="{Binding PruneUnusedImagesCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker image prune -a">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="Неиспользуемые образы"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Destructive}"
                        Command="{Binding PruneVolumesCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker volume prune – в томах лежат данные!">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Database}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="Неиспользуемые тома"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <CheckBox Content="включая именованные (-a)"
                          IsChecked="{Binding PruneAllVolumes}"
                          IsEnabled="{Binding CanRun}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,8"
                          ToolTip="docker volume prune -a – снесёт и именованные тома, не только анонимные" />
            </WrapPanel>

            <Separator Margin="0,10"
                       Background="{DynamicResource Border.Subtle}" />

            <TextBlock Text="Вернуть место на диск"
                       Style="{StaticResource Docker.ColumnHeader}"
                       Margin="0,0,0,2" />
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource TextBlock.Subtle}"
                       Foreground="{DynamicResource Fg.Muted}"
                       Margin="0,0,0,8"
                       Text="После очистки образ диска Docker (VHDX) сам не сжимается. Эта кнопка остановит WSL и вернёт освободившееся место системе – потом запустите Docker заново." />
            <Button Style="{StaticResource Button.Primary}"
                    Command="{Binding CompactCommand}"
                    IsEnabled="{Binding CanRun}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Shrink}"
                                              Style="{StaticResource Docker.ActionButtonContent}" />
                    <TextBlock Text="Сжать диск Docker"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
