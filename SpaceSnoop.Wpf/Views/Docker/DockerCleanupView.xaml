<UserControl x:Class="SpaceSnoop.Wpf.Views.Docker.DockerCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Docker"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DockerViewModel}">
    <UserControl.Resources>
        <Style x:Key="Docker.ActionButtonContent"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="15" />
            <Setter Property="Height"
                    Value="15" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
        </Style>
        <Style x:Key="Docker.DangerGlyph"
               TargetType="iconPacks:PackIconLucide"
               BasedOn="{StaticResource Docker.ActionButtonContent}">
            <Setter Property="Foreground"
                    Value="{DynamicResource State.ErrorText}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}"
            Padding="12"
            Margin="0,0,0,2">
        <StackPanel>
            <TextBlock Text="Очистка Docker"
                       Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Каждая операция попросит подтверждение."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <TextBlock Text="Не затрагивают работающие контейнеры"
                       Style="{StaticResource Caption}"
                       Margin="0,14,0,6" />
            <WrapPanel>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneBuildCacheCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker builder prune">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Hammer}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="{Binding BuildCacheCaption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneDanglingImagesCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker image prune">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Image}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="Висячие образы"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneStoppedContainersCommand}"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker container prune">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Box}"
                                                  Style="{StaticResource Docker.ActionButtonContent}" />
                        <TextBlock Text="{Binding ContainersCaption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Grid Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                          Width="13"
                                          Height="13"
                                          VerticalAlignment="Center"
                                          Margin="0,0,7,0"
                                          AutomationProperties.Name="Предупреждение"
                                          Foreground="{DynamicResource State.ErrorText}" />
                <TextBlock Grid.Column="1"
                           Text="Уберут и то, что ещё может понадобиться"
                           Style="{StaticResource Caption}" />
            </Grid>
            <WrapPanel>
                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding PruneUnusedImagesCommand}"
                        VerticalAlignment="Top"
                        IsEnabled="{Binding CanRun}"
                        Margin="0,0,8,8"
                        ToolTip="docker image prune -a">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Style="{StaticResource Docker.DangerGlyph}" />
                        <TextBlock Text="Неиспользуемые образы"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Base}"
                            Command="{Binding PruneVolumesCommand}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding CanRun}"
                            Margin="0,0,8,8"
                            ToolTip="docker volume prune – в томах лежат данные!">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Database}"
                                                      Style="{StaticResource Docker.DangerGlyph}" />
                            <TextBlock Text="Неиспользуемые тома"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox Content="Удалять и именованные тома, не только анонимные"
                              IsChecked="{Binding PruneAllVolumes}"
                              IsEnabled="{Binding CanRun}"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,2"
                              ToolTip="docker volume prune -a" />
                </StackPanel>
            </WrapPanel>

            <Expander Style="{StaticResource Expander.Section}" Margin="0,6,0,0"
                      Header="Вернуть место на диск Windows">
            <StackPanel Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource TextBlock.Subtle}"
                       Text="Очистка освобождает место внутри образа данных Docker, но сам файл VHDX не уменьшается. Кнопка остановит Docker Desktop и вернёт освободившееся системе." />
            <TextBlock Text="{Binding Compact.DiskUsageText}"
                       ToolTip="{Binding Compact.DiskPath}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock Text="Для сжатия перезапустите SpaceSnoop от администратора."
                       TextWrapping="Wrap"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,6,0,0"
                       Visibility="{Binding Compact.IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock
                Text="Все контейнеры будут остановлены. После запуска diskpart безопасная отмена недоступна; Docker потребуется запустить заново."
                Foreground="{DynamicResource State.WarningText}"
                TextWrapping="Wrap"
                Margin="0,6,0,0" />
            <Expander Style="{StaticResource Expander.Section}"
                      Margin="0,4,0,0">
                <Expander.Header>
                    <TextBlock Text="Что нужно знать до запуска"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontWeight="{DynamicResource Font.Weight.Regular}" />
                </Expander.Header>
                <TextBlock TextWrapping="Wrap"
                           Margin="6,0,0,0"
                           Style="{StaticResource TextBlock.Subtle}"
                           Text="Операция экспериментальная и может занять много времени. После запуска diskpart безопасная отмена недоступна – дождитесь конца и запустите Docker заново. Если штатная остановка не сработает, приложение отдельно спросит про остановку всего WSL." />
            </Expander>
            <Button Style="{StaticResource Button.Secondary}"
                    Command="{Binding Compact.RunCommand}"
                    ToolTip="{Binding CompactHint}"
                    ToolTipService.ShowOnDisabled="True"
                    IsEnabled="{Binding CanRun}"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Shrink}"
                                              Style="{StaticResource Docker.ActionButtonContent}" />
                    <TextBlock Text="Сжать диск Docker"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
