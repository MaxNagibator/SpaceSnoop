<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsFileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Файл настроек"
                           Style="{StaticResource Setting.SectionTitle}" />
                <TextBlock Text="{Binding SettingsFilePath}"
                           Style="{StaticResource TextBlock.Mono}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Setting.Hint}"
                           Text="Формат TOML. Можно править вручную, но удобнее через эту форму. Изменения сохраняются автоматически." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}"
                        Command="{Binding CopySettingsPathCommand}"
                        Margin="0,0,0,4"
                        AutomationProperties.Name="Скопировать путь"
                        ToolTip="Скопировать путь в буфер обмена">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource Button.Icon}"
                        Command="{Binding OpenSettingsFileCommand}"
                        AutomationProperties.Name="Показать в проводнике"
                        ToolTip="Показать файл в проводнике">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ExternalLink}"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
