<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsFileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Settings"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900"
             Visibility="{Binding Sections[storage].IsSelected, Converter={StaticResource BoolToVisibility}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <HeaderedContentControl Style="{StaticResource Setting.Panel}"
                            Header="{Binding Sections[storage].Title}">
        <StackPanel>
            <TextBlock Text="Расположение данных"
                       Style="{StaticResource Setting.SectionTitle}" />
            <CheckBox Content="Хранить файлы приложения в папке AppData"
                      IsChecked="{Binding StoreInAppData, Mode=TwoWay}"
                      Margin="0,12,0,0"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Setting.CheckHint}"
                       Text="Смена расположения перезапустит приложение." />
            <Expander Style="{StaticResource Setting.CheckDetails}">
                <TextBlock Style="{StaticResource Setting.Hint}"
                           Text="По умолчанию настройки, логи и журналы лежат в %LOCALAPPDATA%\SpaceSnoop. Выключите, чтобы держать их рядом с программой – portable-режим. Файлы можно перенести на новое место или оставить на старом, об этом спросит диалог." />
            </Expander>
            <TextBlock Text="{Binding DataDirectory}"
                       Style="{StaticResource TextBlock.Mono}"
                       Margin="26,8,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="Файл настроек"
                       Style="{StaticResource Setting.SectionTitle}"
                       Margin="0,20,0,0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SettingsFilePath}"
                               Style="{StaticResource TextBlock.Mono}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Setting.Hint}"
                               Text="Формат TOML, изменения сохраняются автоматически." />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CopySettingsPathCommand}"
                            Margin="0,0,0,4"
                            AutomationProperties.Name="Скопировать путь"
                            ToolTip="Скопировать путь в буфер обмена">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding OpenSettingsFileCommand}"
                            AutomationProperties.Name="Показать в проводнике"
                            ToolTip="Показать файл в проводнике">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ExternalLink}"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
