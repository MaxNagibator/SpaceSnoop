<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="Setting.ContentWidth">760</sys:Double>
    <sys:Double x:Key="Setting.ControlWidth">280</sys:Double>
    <sys:Double x:Key="Setting.SliderWidth">228</sys:Double>

    <Style x:Key="Setting.DetailsHeader"
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlock.Subtle}">
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.Regular}" />
    </Style>

    <Style x:Key="Setting.DetailsBody"
           TargetType="TextBlock"
           BasedOn="{StaticResource Form.Hint}">
        <Setter Property="Margin"
                Value="6,6,0,0" />
    </Style>

    <Style x:Key="Setting.Details"
           TargetType="Expander"
           BasedOn="{StaticResource Expander.Section}">
        <Setter Property="Margin"
                Value="0,2,0,0" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Style="{StaticResource Setting.DetailsHeader}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
