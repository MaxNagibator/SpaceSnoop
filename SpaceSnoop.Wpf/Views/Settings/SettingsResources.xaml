<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <sys:Double x:Key="Setting.ContentWidth">960</sys:Double>
    <sys:Double x:Key="Setting.ControlWidth">280</sys:Double>
    <sys:Double x:Key="Setting.SliderWidth">228</sys:Double>

    <Style x:Key="Setting.Label"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="Setting.SectionTitle"
           TargetType="TextBlock">
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
    </Style>

    <Style x:Key="Setting.Hint"
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlock.Subtle}">
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="Margin"
                Value="0,6,0,0" />
    </Style>

    <Style x:Key="Setting.CheckHint"
           TargetType="TextBlock"
           BasedOn="{StaticResource Setting.Hint}">
        <Setter Property="Margin"
                Value="26,6,0,0" />
    </Style>

    <Style x:Key="Setting.Value"
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlock.Mono}">
        <Setter Property="TextAlignment"
                Value="Right" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="MinWidth"
                Value="44" />
        <Setter Property="Margin"
                Value="8,0,0,0" />
    </Style>

    <Style x:Key="Setting.Details"
           TargetType="Expander"
           BasedOn="{StaticResource Expander.Section}">
        <Setter Property="Header"
                Value="Подробнее" />
        <Setter Property="Margin"
                Value="0,2,0,0" />
    </Style>

    <Style x:Key="Setting.CheckDetails"
           TargetType="Expander"
           BasedOn="{StaticResource Setting.Details}">
        <Setter Property="Margin"
                Value="26,2,0,0" />
    </Style>

    <Style x:Key="Setting.Card"
           TargetType="Expander">
        <Setter Property="Margin"
                Value="0,0,0,10" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Style="{StaticResource Card.Inset}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton Grid.Row="0"
                                          Cursor="Hand"
                                          Focusable="True"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBd"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Radius.S}"
                                                Padding="4,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="HeaderBd"
                                                        Property="Background"
                                                        Value="{DynamicResource Bg.Surface}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource Fg.Primary}"
                                                      TextElement.FontWeight="{DynamicResource Font.Weight.SemiBold}" />
                                    <iconPacks:PackIconLucide x:Name="ChevronClosed"
                                                              Grid.Column="1"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.ChevronDown}"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Fg.Muted}" />
                                    <iconPacks:PackIconLucide x:Name="ChevronOpen"
                                                              Grid.Column="1"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.ChevronUp}"
                                                              Width="14"
                                                              Height="14"
                                                              Visibility="Collapsed"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Fg.Muted}" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentArea"
                                              Grid.Row="1"
                                              Margin="0,10,0,0"
                                              Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded"
                                 Value="True">
                            <Setter TargetName="ContentArea"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="ChevronClosed"
                                    Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="ChevronOpen"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
