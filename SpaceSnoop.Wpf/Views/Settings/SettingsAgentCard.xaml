<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsAgentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="Агент-чат"
                       Style="{StaticResource Setting.SectionTitle}" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Страница «Чат» говорит с уже установленным на этой машине CLI – по вашей подписке, без ключей и токенов в настройках приложения. Сообщение и то, что агент запрашивает у инструментов (пути, размеры, результаты сравнения), уходит в CLI и дальше поставщику модели под вашей подпиской." />

            <CheckBox Content="Показывать страницу чата"
                      IsChecked="{Binding Agent.Enabled, Mode=TwoWay}"
                      Margin="0,14,0,0"
                      VerticalAlignment="Center" />

            <CheckBox Content="Согласие на отправку данных дано"
                      IsChecked="{Binding Agent.Consent, Mode=TwoWay}"
                      Margin="0,12,0,0"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Снимите галку, чтобы отозвать согласие – страница чата снова покажет предупреждение и спросит его перед следующим сообщением." />

            <TextBlock Text="CLI"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <ListBox Style="{StaticResource ListBox.Segmented}"
                     ItemsSource="{Binding AgentBackendOptions}"
                     SelectedIndex="{Binding SelectedAgentBackendIndex}"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Модель и путь ниже относятся к выбранному CLI – у каждого свои." />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Foreground="{DynamicResource State.Warning}"
                       Text="У codex есть собственная оболочка операционной системы, и отключить её нечем: помимо инструментов приложения агент может выполнять команды с правами SpaceSnoop, а оно обычно запущено от администратора. Инструменты приложения при этом работают только с полным доступом – при песочнице codex не может дозваться разрешения и гасит вызов сам. Из-за оболочки запрет отдельных инструментов для codex – подсказка, а не преграда: настоящий барьер один и тот же для обоих CLI – галка «Разрешить изменяющие операции» ниже, её проверяет сам MCP-сервер."
                       Visibility="{Binding AgentShellWarning, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Модель"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      ItemsSource="{Binding AgentModel.ModelOptions}"
                      SelectedItem="{Binding AgentModel.SelectedModel, Mode=TwoWay}"
                      Width="320"
                      HorizontalAlignment="Left"
                      Margin="0,8,0,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"
                                   ToolTip="{Binding Hint}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="{Binding AgentModel.SelectedModel.Hint}" />

            <TextBlock Text="Свой слаг модели"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Agent.Model, UpdateSourceTrigger=LostFocus}"
                     Width="320"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Модель, которой нет в списке: слаг уходит в CLI как есть и появляется отдельным пунктом выше. Пусто – модель, выбранная по умолчанию в самом CLI." />

            <TextBlock Text="Глубина рассуждений"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      ItemsSource="{Binding AgentModel.EffortOptions}"
                      SelectedItem="{Binding AgentModel.SelectedEffort, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      Width="320"
                      HorizontalAlignment="Left"
                      Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Чем выше уровень, тем дольше и дороже ответ. «По умолчанию» – уровень, выбранный самим CLI для этой модели." />

            <TextBlock Text="{Binding AgentCliPathLabel}"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Agent.CliPath, UpdateSourceTrigger=LostFocus}"
                     FontFamily="{DynamicResource Font.Mono}"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Пусто – найти автоматически в PATH и типичных местах установки." />
        </StackPanel>
    </Border>
</UserControl>
