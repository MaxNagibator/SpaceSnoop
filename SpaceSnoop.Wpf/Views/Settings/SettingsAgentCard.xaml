<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsAgentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900"
             Visibility="{Binding Sections[agent].IsVisible, Converter={StaticResource BoolToVisibility}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander Style="{StaticResource Setting.Card}"
              Header="{Binding Sections[agent].Title}"
              IsExpanded="{Binding Sections[agent].IsExpanded, Mode=TwoWay}">
        <StackPanel>
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Margin="0"
                       Text="Страница «Чат» говорит с установленным на этой машине CLI по вашей подписке." />
            <Expander Style="{StaticResource Setting.Details}">
                <TextBlock Style="{StaticResource Setting.Hint}"
                           Text="Ключи и токены поставщика модели в настройках приложения не хранятся. Сообщение и то, что агент запрашивает у инструментов – пути, размеры, результаты сравнения, – уходит в CLI и дальше поставщику модели под вашей подпиской." />
            </Expander>

            <CheckBox Content="Показывать страницу чата"
                      IsChecked="{Binding Agent.Enabled, Mode=TwoWay}"
                      Margin="0,14,0,0"
                      VerticalAlignment="Center" />

            <CheckBox Content="Согласие на отправку данных дано"
                      IsChecked="{Binding Agent.Consent, Mode=TwoWay}"
                      Margin="0,12,0,0"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Setting.CheckHint}"
                       Text="Снимите галку, чтобы отозвать согласие – чат спросит его перед следующим сообщением." />

            <CheckBox Content="Записывать транскрипт хода"
                      IsChecked="{Binding Agent.Transcript, Mode=TwoWay}"
                      Margin="0,12,0,0"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Setting.CheckHint}"
                       Text="Для разбора странных ответов: ход целиком ложится в logs/chat." />
            <Expander Style="{StaticResource Setting.CheckDetails}">
                <TextBlock Style="{StaticResource Setting.Hint}"
                           Text="Всё, что уходит в CLI и приходит от него, пишется отдельным файлом на ход, кнопка на сообщении его открывает. Токен доступа затирается, остальное сохраняется как есть – вопрос, состояние окна и ответы инструментов. Хранятся последние 20 ходов." />
            </Expander>

            <TextBlock Text="CLI"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <ListBox Style="{StaticResource ListBox.Segmented}"
                     ItemsSource="{Binding AgentBackendOptions}"
                     SelectedIndex="{Binding SelectedAgentBackendIndex}"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Модель и путь ниже относятся к выбранному CLI – у каждого свои." />

            <StackPanel Visibility="{Binding AgentShellWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Setting.Hint}"
                           Foreground="{DynamicResource State.Warning}"
                           Text="У codex есть собственная оболочка системы, отключить её нечем: агент может выполнять команды с правами приложения." />
                <Expander Style="{StaticResource Setting.Details}">
                    <TextBlock Style="{StaticResource Setting.Hint}"
                               Foreground="{DynamicResource State.Warning}"
                               Text="Приложение обычно запущено от администратора, значит команды выполняются с его правами. Инструменты приложения при этом работают только с полным доступом – в песочнице codex не может дозваться разрешения и гасит вызов сам. Из-за оболочки запрет отдельных инструментов для codex остаётся подсказкой, а не преградой: настоящий барьер один для обоих CLI – галка «Разрешить изменяющие операции» в разделе «MCP-сервер», её проверяет сам сервер." />
                </Expander>
            </StackPanel>

            <TextBlock Text="Модель"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">
                <ComboBox Style="{StaticResource ComboBox.Form}"
                          ItemsSource="{Binding AgentModel.ModelOptions}"
                          SelectedItem="{Binding AgentModel.SelectedModel, Mode=TwoWay}"
                          Width="{StaticResource Setting.ControlWidth}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       ToolTip="{Binding Hint}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Style="{StaticResource Button.Icon}"
                        Command="{Binding AgentModel.ReloadModelsCommand}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Обновить список моделей"
                        ToolTip="Спросить у CLI, какие модели доступны сейчас">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="{Binding AgentModel.SelectedModel.Hint}" />

            <TextBlock Text="Свой слаг модели"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Agent.Model, UpdateSourceTrigger=LostFocus}"
                     Width="{StaticResource Setting.ControlWidth}"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="{Binding AgentModelHint}" />

            <TextBlock Text="Глубина рассуждений"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      ItemsSource="{Binding AgentModel.EffortOptions}"
                      SelectedItem="{Binding AgentModel.SelectedEffort, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      Width="{StaticResource Setting.ControlWidth}"
                      HorizontalAlignment="Left"
                      Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Чем выше уровень, тем дольше и дороже ответ. «По умолчанию» – уровень самого CLI." />

            <TextBlock Text="{Binding AgentCliPathLabel}"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Agent.CliPath, UpdateSourceTrigger=LostFocus}"
                     FontFamily="{DynamicResource Font.Mono}"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Пусто – найти автоматически в PATH и типичных местах установки." />
        </StackPanel>
    </Expander>
</UserControl>
