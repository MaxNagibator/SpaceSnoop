<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsAgentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="Агент-чат"
                       Style="{StaticResource Setting.SectionTitle}" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Страница «Чат» говорит с уже установленным на этой машине CLI Claude Code – по вашей подписке, без ключей и токенов Anthropic в настройках приложения. Сообщение и то, что агент запрашивает у инструментов (пути, размеры, результаты сравнения), уходит в CLI и дальше в Anthropic под вашей подпиской." />

            <CheckBox Content="Показывать страницу чата"
                      IsChecked="{Binding Agent.Enabled, Mode=TwoWay}"
                      Margin="0,14,0,0"
                      VerticalAlignment="Center" />

            <CheckBox Content="Согласие на отправку данных дано"
                      IsChecked="{Binding Agent.Consent, Mode=TwoWay}"
                      Margin="0,12,0,0"
                      VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Снимите галку, чтобы отозвать согласие – страница чата снова покажет предупреждение и спросит его перед следующим сообщением." />

            <TextBlock Text="Модель"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Agent.Model, UpdateSourceTrigger=LostFocus}"
                     Width="260"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Пусто – модель, выбранная по умолчанию в самом CLI." />

            <TextBlock Text="Путь к claude.exe"
                       Style="{StaticResource Setting.Label}"
                       Margin="0,16,0,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Agent.CliPath, UpdateSourceTrigger=LostFocus}"
                     FontFamily="{DynamicResource Font.Mono}"
                     Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Setting.Hint}"
                       Text="Пусто – найти автоматически в PATH и типичных местах установки." />
        </StackPanel>
    </Border>
</UserControl>
