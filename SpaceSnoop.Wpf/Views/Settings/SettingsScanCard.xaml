<UserControl x:Class="SpaceSnoop.Wpf.Views.Settings.SettingsScanCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Settings"
             xmlns:bootstrap="clr-namespace:SpaceSnoop.Wpf.Bootstrap"
             xmlns:settings="clr-namespace:SpaceSnoop.Wpf.Views.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900"
             Visibility="{Binding Sections[scan].IsSelected, Converter={StaticResource BoolToVisibility}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <HeaderedContentControl Style="{StaticResource Form.Panel}"
                            Header="{Binding Sections[scan].Title}"
                            keepshell:Form.ResetCommand="{Binding ResetSectionCommand}"
                            keepshell:Form.ResetCommandParameter="scan"
                            keepshell:Form.ResetHint="{Binding ResetPlans[scan].Hint}">
        <StackPanel>
            <Grid settings:SettingsBlock.Key="parallel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Многопоточный обход"
                          IsChecked="{Binding Scan.UseMultithreading, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.multithreading]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="Параллельный обход каталогов – быстрее, но выше расход памяти." />

            <keepshell:SettingRowPanel Margin="0,16,0,0"
                                      IsEnabled="{Binding Scan.UseMultithreading}">
                <StackPanel>
                    <TextBlock Text="Число параллельных потоков"
                               Style="{StaticResource Form.Label}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Form.Hint}"
                               Margin="0,2,0,0"
                               Text="{Binding Scan.ParallelismHint}" />
                    <Expander Style="{StaticResource Setting.Details}"
                              Header="Сколько ставить">
                        <TextBlock Style="{StaticResource Setting.DetailsBody}"
                                   Text="{Binding Scan.ParallelismDetails}" />
                    </Expander>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Top">
                    <Slider Minimum="1"
                            Maximum="{Binding Scan.ParallelismCeiling}"
                            Value="{Binding Scan.MaxParallelism, Mode=TwoWay}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="{StaticResource Setting.SliderWidth}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Scan.MaxParallelism, StringFormat=N0}"
                               Style="{StaticResource Form.Value}" />
                </StackPanel>
                <Button Style="{StaticResource Form.RowReset}"
                        VerticalAlignment="Top"
                        DataContext="{Binding ResetFields[wpf.scan.parallelism]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </keepshell:SettingRowPanel>

            <Grid Margin="0,16,0,0"
                  IsEnabled="{Binding Scan.UseMultithreading}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Учитывать тип носителя"
                          IsChecked="{Binding Scan.MediaAware, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.media_aware]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="На жёстком диске с вращающимися пластинами (HDD) обход идёт в один поток – так он быстрее." />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Когда обход идёт в один поток">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="У вращающегося диска параллельный обход заставляет головку метаться между каталогами и отнимает больше, чем даёт. Тип носителя спрашивается у драйвера один раз на том, поэтому внешний диск, подменённый под той же буквой, до перезапуска отвечает прежним типом. Сетевые пути и носители, о которых драйвер молчит, считаются неизвестными, и для них настройка ничего не меняет." />
            </Expander>

            <Grid Margin="0,16,0,0"
                  settings:SettingsBlock.Key="mft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Читать таблицу NTFS вместо обхода каталогов"
                          IsChecked="{Binding Scan.MftEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.mft.enabled]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="Вдвое быстрее, и жёсткая ссылка считается один раз, а не под каждым именем." />
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Foreground="{DynamicResource State.WarningText}"
                       Text="Сейчас прав администратора нет, поэтому скан пойдёт обходом каталогов."
                       Visibility="{Binding Scan.MftNeedsElevation, Converter={StaticResource BoolToVisibility}}" />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Что нужно движку NTFS">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="Движок читает служебную таблицу тома напрямую, поэтому ему нужны права администратора и локальный том NTFS. Сетевой диск, флешка с exFAT, отсутствие прав или сбой разбора дают тихий откат на обычный обход – итог получится прежним, о причине скажет журнал. Таблица читается целиком независимо от того, что сканируют, поэтому на одном подкаталоге движок проигрывает обходу, а на диске целиком выигрывает вдвое. Часть записей в дерево не попадает по устройству формата (оторванные, повреждённые, без имени) – их число показывает полоса итогов, а не умалчивает." />
            </Expander>

            <Grid Margin="26,12,0,0"
                  IsEnabled="{Binding Scan.MftEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Только при сканировании диска целиком"
                          IsChecked="{Binding Scan.MftRootOnly, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.mft.root_only]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Margin="52,6,0,0"
                       Text="Выбран каталог – скан пойдёт обходом, потому что таблица читается вся, сколько бы ни было в цели." />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Когда галку стоит снять"
                      Margin="26,2,0,0">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="На подкаталоге чтение тома целиком стоит дороже обхода, а числа неполноты в полосе итогов всё равно считаются по всему тому, а не по выбранной ветке. Выключите, если счёт жёстких ссылок один раз нужен и внутри каталога – например, в папке Windows, которая почти целиком из них состоит." />
            </Expander>

            <Grid Margin="0,16,0,0"
                  settings:SettingsBlock.Key="memory">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Освобождать прежний результат перед повторным сканом"
                          IsChecked="{Binding Scan.ReleaseBeforeRescan, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.release_before_rescan]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="Два дерева одной папки в памяти не держатся, но на время скана результат пропадает с экрана." />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Что будет при отмене и с пометками">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="Прежнее дерево той же папки снимается в начале скана, а не в конце, поэтому пик памяти меньше на целое дерево – на диске целиком это сотни мегабайт. Отменили скан или он упал – результата у папки не будет, пока не просканируете её снова. Дерево с пометками на удаление не снимается никогда: оно остаётся на экране до конца скана, как при выключенной настройке." />
            </Expander>

            <Grid Margin="26,12,0,0"
                  IsEnabled="{Binding Scan.ReleaseBeforeRescan}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Предупреждать перед повторным сканом"
                          IsChecked="{Binding Scan.ConfirmRescan, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.confirm_rescan]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Margin="52,6,0,0"
                       Text="Пока прежний результат освобождается перед сканом, программа спросит, заменить ли его, если у папки уже есть результат." />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Возвращать память системе после скана"
                          IsChecked="{Binding Scan.ReturnMemoryAfterScan, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.return_memory_after_scan]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="При нехватке памяти приложение отдаст системе память обхода. Если памяти достаточно, принудительная сборка не запускается." />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Когда галку стоит включить">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="После большого скана приложение проверяет нагрузку памяти. Когда достигнут порог, установленный средой .NET, выполняется уплотняющая сборка: другим программам достанется больше памяти, но окно может ненадолго замереть. При достаточном запасе памяти сборка пропускается, чтобы избежать этой паузы. Результат скана не меняется; небольшие папки настройка не затрагивает." />
            </Expander>

            <keepshell:SettingRowPanel Margin="0,16,0,0"
                                      settings:SettingsBlock.Key="view">
                <StackPanel>
                    <TextBlock Text="Интенсивность тепловой подсветки"
                               Style="{StaticResource Form.Label}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Form.Hint}"
                               Margin="0,2,0,0"
                               Text="Насколько ярко строка дерева окрашена по доле размера." />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Slider Minimum="{x:Static bootstrap:AppDefaults.IntensityMin}"
                            Maximum="{x:Static bootstrap:AppDefaults.IntensityMax}"
                            Value="{Binding Scan.Intensity, Mode=TwoWay}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="{StaticResource Setting.SliderWidth}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Scan.Intensity, StringFormat=N0}"
                               Style="{StaticResource Form.Value}" />
                </StackPanel>
                <Button Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.intensity]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </keepshell:SettingRowPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Выделять файлы в проводнике, не запускать"
                          IsChecked="{Binding Scan.RevealFiles, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Form.RowReset}"
                        DataContext="{Binding ResetFields[wpf.scan.reveal_files]}"
                        Command="{Binding ResetCommand}"
                        ToolTip="{Binding Hint}"
                        AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
            <TextBlock Style="{StaticResource Form.CheckHint}"
                       Text="Выключите, чтобы файл из дерева открывался программой по умолчанию." />
            <Expander Style="{StaticResource Setting.Details}"
                      Header="Что будет, если выключить">
                <TextBlock Style="{StaticResource Setting.DetailsBody}"
                           Text="При включённой настройке проводник подсвечивает файл в папке и ничего не выполняет. При выключенной исполняемые файлы запускаются." />
            </Expander>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
