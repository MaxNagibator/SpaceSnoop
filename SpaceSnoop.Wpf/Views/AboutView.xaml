<UserControl x:Class="SpaceSnoop.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="About.SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="{DynamicResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
        </Style>

        <Style x:Key="About.FeatureIcon"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Accent.Primary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="About.FeatureCard"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="Padding"
                    Value="14" />
        </Style>

        <Style x:Key="About.MetaIcon"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="16" />
            <Setter Property="Height"
                    Value="16" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,10,0" />
        </Style>

        <Style x:Key="About.MetaLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="About.MetaValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Mono}">
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
        <StackPanel>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="{DynamicResource Radius.M}"
                                Background="{DynamicResource Bg.SurfaceAlt}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                            <Image Source="pack://application:,,,/icon.ico"
                                   Width="36"
                                   Height="36"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AppName}"
                                           Style="{StaticResource TextBlock.Display}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge.Info}"
                                        VerticalAlignment="Center"
                                        Margin="12,4,0,0">
                                    <TextBlock Text="{Binding Version}"
                                               FontFamily="{DynamicResource Font.Mono}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Tagline}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource TextBlock.Subtle}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,18,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding OpenRepositoryCommand}"
                                ToolTip="Открыть репозиторий на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Github}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                <TextBlock Text="Репозиторий"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Base}"
                                Command="{Binding OpenReleasesCommand}"
                                Margin="10,0,0,0"
                                ToolTip="Список выпусков на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Tag}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                <TextBlock Text="Релизы"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Base}"
                                Command="{Binding ReportIssueCommand}"
                                Margin="10,0,0,0"
                                ToolTip="Открыть форму issue с метаданными среды и хвостом лога">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Bug}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                <TextBlock Text="Нашёл баг?"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Что умеет шнырь"
                               Style="{StaticResource About.SectionTitle}" />

                    <UniformGrid Columns="3"
                                 Margin="0,14,0,-10">
                        <Border Style="{StaticResource About.FeatureCard}">
                            <StackPanel>
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.HardDrive}"
                                                          Style="{StaticResource About.FeatureIcon}"
                                                          HorizontalAlignment="Left" />
                                <TextBlock Text="Сканирование"
                                           Style="{StaticResource About.SectionTitle}"
                                           Margin="0,10,0,0" />
                                <TextBlock
                                    Text="Дерево занятого места, где жирные папки краснеют от стыда по доле размера, или карта-treemap — те же тяжёлые ветки плитками по площади. Помечаешь хлам — и он улетает в корзину, без членовредительства."
                                    Style="{StaticResource TextBlock.Subtle}"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource About.FeatureCard}">
                            <StackPanel>
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRightLeft}"
                                                          Style="{StaticResource About.FeatureIcon}"
                                                          HorizontalAlignment="Left" />
                                <TextBlock Text="Синхронизация"
                                           Style="{StaticResource About.SectionTitle}"
                                           Margin="0,10,0,0" />
                                <TextBlock
                                    Text="Сводит две папки лицом к лицу: цветом видно, кто где лишний, изменённые сверяются по хешу, а перенос — в любую из трёх сторон."
                                    Style="{StaticResource TextBlock.Subtle}"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource About.FeatureCard}"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ScrollText}"
                                                          Style="{StaticResource About.FeatureIcon}"
                                                          HorizontalAlignment="Left" />
                                <TextBlock Text="Логи"
                                           Style="{StaticResource About.SectionTitle}"
                                           Margin="0,10,0,0" />
                                <TextBlock
                                    Text="Живой поток событий с фильтрами по уровню, источнику и подстроке. Что-то пошло не так — собери отчёт об ошибке одной кнопкой."
                                    Style="{StaticResource TextBlock.Subtle}"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Под капотом"
                                   Style="{StaticResource About.SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Icon}"
                                Command="{Binding CopyDiagnosticsCommand}"
                                AutomationProperties.Name="Скопировать сведения"
                                ToolTip="Скопировать сведения об окружении в буфер обмена">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                                      Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Tag}"
                                                      Style="{StaticResource About.MetaIcon}" />
                            <TextBlock Text="Версия"
                                       Style="{StaticResource About.MetaLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding Version}"
                                   Style="{StaticResource About.MetaValue}"
                                   Margin="20,0,0,10" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Package}"
                                                      Style="{StaticResource About.MetaIcon}" />
                            <TextBlock Text="Платформа"
                                       Style="{StaticResource About.MetaLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding DotNetVersion}"
                                   Style="{StaticResource About.MetaValue}"
                                   Margin="20,0,0,10" />

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Monitor}"
                                                      Style="{StaticResource About.MetaIcon}" />
                            <TextBlock Text="Операционная система"
                                       Style="{StaticResource About.MetaLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding OperatingSystem}"
                                   Style="{StaticResource About.MetaValue}"
                                   Margin="20,0,0,10" />

                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Cpu}"
                                                      Style="{StaticResource About.MetaIcon}" />
                            <TextBlock Text="Архитектура процесса"
                                       Style="{StaticResource About.MetaLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding Architecture}"
                                   Style="{StaticResource About.MetaValue}"
                                   Margin="20,0,0,0" />
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Bg.SurfaceMute}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Width="16"
                                                      Height="16"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Setter Property="Kind"
                                                Value="Shield" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource State.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}"
                                                         Value="True">
                                                <Setter Property="Kind"
                                                        Value="ShieldCheck" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource State.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                            <TextBlock Text="{Binding ElevationCaption}"
                                       Style="{StaticResource About.MetaLabel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Опенсорс, всё по-честному — заходи, шныряй, контрибьють"
                                   Style="{StaticResource About.MetaLabel}" />
                        <TextBlock Text="{Binding RepoSlug}"
                                   Style="{StaticResource TextBlock.Mono}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Link}"
                            Command="{Binding OpenRepositoryCommand}"
                            VerticalAlignment="Center"
                            ToolTip="Открыть репозиторий на GitHub">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Открыть на GitHub"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ExternalLink}"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
