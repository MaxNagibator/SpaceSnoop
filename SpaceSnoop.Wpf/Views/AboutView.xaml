<UserControl x:Class="SpaceSnoop.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.About"
             xmlns:about="clr-namespace:SpaceSnoop.Wpf.Views.About"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/About/AboutResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
        <StackPanel>
            <about:AboutHeroCard />
            <about:AboutFeaturesCard />
            <about:AboutEnvironmentCard />
            <about:AboutRepositoryCard />

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,10,0,10"
                    Padding="14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="История изменений"
                                   Style="{StaticResource About.SectionTitle}"
                                   FontSize="{DynamicResource Font.Size.M}"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="1"
                                    Margin="12,0,0,0">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Command="{Binding Updater.LoadChangelogCommand}"
                                    ToolTip="Обновить историю изменений"
                                    MinHeight="0"
                                    Height="32"
                                    Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                              Width="16"
                                                              Height="16"
                                                              Margin="0,0,8,0" />
                                    <TextBlock Text="Обновить" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Secondary}"
                                    Command="{Binding OpenReleasesCommand}"
                                    ToolTip="Открыть релизы на GitHub"
                                    Margin="8,0,0,0"
                                    MinHeight="0"
                                    Height="32"
                                    Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide
                                        Kind="{x:Static iconPacks:PackIconLucideKind.ExternalLink}"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0" />
                                    <TextBlock Text="GitHub" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Updater.ChangelogStatus}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               Margin="0,8,0,0"
                               Visibility="{Binding Updater.HasChangelogStatus, Converter={StaticResource BoolToVisibility}}" />

                    <ScrollViewer MaxHeight="560"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Updater.HasChangelog, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Updater.ChangelogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,8,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                               Foreground="{DynamicResource Fg.Primary}" />
                                                    <TextBlock Text="{Binding PublishedDate}"
                                                               Margin="10,0,0,0"
                                                               Foreground="{DynamicResource Fg.Muted}" />
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource Button.Secondary}"
                                                        Command="{Binding DataContext.OpenReleaseUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding CompareUrl}"
                                                        ToolTip="Открыть сравнение на GitHub"
                                                        MinHeight="0"
                                                        Height="28"
                                                        Padding="8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconLucide
                                                            Kind="{x:Static iconPacks:PackIconLucideKind.GitCompare}"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,6,0" />
                                                        <TextBlock Text="Полный список" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Changes}"
                                                          Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="14" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="•"
                                                                       Foreground="{DynamicResource Accent.Primary}"
                                                                       VerticalAlignment="Top" />

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Summary}"
                                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                                           TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Details}"
                                                                              Margin="0,4,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}"
                                                                                    Foreground="{DynamicResource Fg.Muted}"
                                                                                    TextWrapping="Wrap"
                                                                                    Margin="0,0,0,3" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
