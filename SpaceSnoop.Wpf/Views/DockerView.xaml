<UserControl x:Class="SpaceSnoop.Wpf.Views.DockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DockerViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="Docker.SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="{DynamicResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
        </Style>

        <Style x:Key="Docker.ColumnHeader"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
        </Style>

        <Style x:Key="Docker.ActionButtonContent"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="15" />
            <Setter Property="Height"
                    Value="15" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
        </Style>

        <DataTemplate x:Key="Docker.ObjectRow"
                      DataType="{x:Type vm:DockerObjectViewModel}">
            <Border Padding="0,7"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="{Binding IconKind}"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Foreground="{DynamicResource Fg.Muted}" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Size}"
                               Style="{StaticResource TextBlock.Mono}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Style="{StaticResource Button.Icon}"
                            Margin="10,0,0,0"
                            Command="{Binding DataContext.RemoveObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding DataContext.CanRun, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            AutomationProperties.Name="Удалить объект"
                            ToolTip="Удалить безвозвратно">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="15"
                                                  Height="15"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource State.Error}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
        <StackPanel>

            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Unplug}"
                                                  Width="20"
                                                  Height="20"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Foreground="{DynamicResource State.Warning}" />
                        <TextBlock Text="Docker недоступен"
                                   Style="{StaticResource Docker.SectionTitle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding UnavailableReason}"
                               Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Убедитесь, что Docker Desktop установлен и запущен, затем обновите."
                               Style="{StaticResource TextBlock.Subtle}"
                               Foreground="{DynamicResource Fg.Muted}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Button Style="{StaticResource Button.Base}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsIdle}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                      Style="{StaticResource Docker.ActionButtonContent}" />
                            <TextBlock Text="Обновить"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Что занимает место"
                                   Style="{StaticResource Docker.SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Icon}"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsIdle}"
                                AutomationProperties.Name="Обновить"
                                ToolTip="Опросить Docker заново">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                      Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Категория"
                                   Style="{StaticResource Docker.ColumnHeader}" />
                        <TextBlock Grid.Column="1"
                                   Text="Объектов"
                                   Style="{StaticResource Docker.ColumnHeader}"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Column="2"
                                   Text="Размер"
                                   Style="{StaticResource Docker.ColumnHeader}"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Column="3"
                                   Text="Можно вернуть"
                                   Style="{StaticResource Docker.ColumnHeader}"
                                   TextAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Buckets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Type}"
                                                   Foreground="{DynamicResource Fg.Primary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalCount}"
                                                   Style="{StaticResource TextBlock.Mono}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Size}"
                                                   Style="{StaticResource TextBlock.Mono}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Reclaimable}"
                                                   Style="{StaticResource TextBlock.Mono}"
                                                   Foreground="{DynamicResource Accent.Primary}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource TextBlock.Subtle}"
                               Foreground="{DynamicResource Fg.Muted}"
                               Margin="0,12,0,0"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Крупнейшие объекты"
                               Style="{StaticResource Docker.SectionTitle}" />
                    <TextBlock
                        Text="Образы, контейнеры и тома по типам. В каждой группе видны 3 крупнейших, остальное разворачивается. Удаление безвозвратно."
                        Style="{StaticResource TextBlock.Subtle}"
                        Foreground="{DynamicResource Fg.Muted}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0" />

                    <ItemsControl ItemsSource="{Binding Groups}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DockerGroupViewModel}">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <iconPacks:PackIconLucide Grid.Column="0"
                                                                  Kind="{Binding IconKind}"
                                                                  Width="16"
                                                                  Height="16"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"
                                                                  Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Docker.SectionTitle}">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text="{Binding Count, Mode=OneWay, StringFormat=' ({0})'}"
                                                 Foreground="{DynamicResource Fg.Muted}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalSize}"
                                                   Style="{StaticResource TextBlock.Mono}"
                                                   Foreground="{DynamicResource Accent.Primary}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Preview}"
                                                  ItemTemplate="{StaticResource Docker.ObjectRow}" />

                                    <ItemsControl ItemsSource="{Binding Rest}"
                                                  ItemTemplate="{StaticResource Docker.ObjectRow}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />

                                    <Button Style="{StaticResource Button.Ghost}"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Command="{Binding ToggleCommand}"
                                            Visibility="{Binding HasRest, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{Binding ToggleIconKind}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ToggleLabel}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Inset}"
                    Margin="0,0,0,2">
                <StackPanel>
                    <TextBlock Text="Очистка"
                               Style="{StaticResource Docker.SectionTitle}" />
                    <TextBlock Text="Операции Docker безвозвратны — мимо корзины. Перед каждой спросим подтверждение."
                               Style="{StaticResource TextBlock.Subtle}"
                               Foreground="{DynamicResource Fg.Muted}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Text="Безопасно"
                               Style="{StaticResource Docker.ColumnHeader}"
                               Margin="0,14,0,6" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Base}"
                                Command="{Binding PruneBuildCacheCommand}"
                                IsEnabled="{Binding CanRun}"
                                Margin="0,0,8,8"
                                ToolTip="docker builder prune">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Hammer}"
                                                          Style="{StaticResource Docker.ActionButtonContent}" />
                                <TextBlock Text="Кэш сборки"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Base}"
                                Command="{Binding PruneDanglingImagesCommand}"
                                IsEnabled="{Binding CanRun}"
                                Margin="0,0,8,8"
                                ToolTip="docker image prune">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Image}"
                                                          Style="{StaticResource Docker.ActionButtonContent}" />
                                <TextBlock Text="Висячие образы"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Base}"
                                Command="{Binding PruneStoppedContainersCommand}"
                                IsEnabled="{Binding CanRun}"
                                Margin="0,0,8,8"
                                ToolTip="docker container prune">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Box}"
                                                          Style="{StaticResource Docker.ActionButtonContent}" />
                                <TextBlock Text="Остановленные контейнеры"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Агрессивно — безвозвратно"
                               Style="{StaticResource Docker.ColumnHeader}"
                               Foreground="{DynamicResource State.Warning}"
                               Margin="0,10,0,6" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Destructive}"
                                Command="{Binding PruneUnusedImagesCommand}"
                                IsEnabled="{Binding CanRun}"
                                Margin="0,0,8,8"
                                ToolTip="docker image prune -a">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                          Style="{StaticResource Docker.ActionButtonContent}" />
                                <TextBlock Text="Неиспользуемые образы"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Destructive}"
                                Command="{Binding PruneVolumesCommand}"
                                IsEnabled="{Binding CanRun}"
                                Margin="0,0,8,8"
                                ToolTip="docker volume prune — в томах лежат данные!">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Database}"
                                                          Style="{StaticResource Docker.ActionButtonContent}" />
                                <TextBlock Text="Неиспользуемые тома"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Separator Margin="0,10"
                               Background="{DynamicResource Border.Subtle}" />

                    <TextBlock Text="Вернуть место на диск"
                               Style="{StaticResource Docker.ColumnHeader}"
                               Margin="0,0,0,2" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource TextBlock.Subtle}"
                               Foreground="{DynamicResource Fg.Muted}"
                               Margin="0,0,0,8"
                               Text="После очистки образ диска Docker (VHDX) сам не сжимается. Эта кнопка остановит WSL и вернёт освободившееся место системе — потом запустите Docker заново." />
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding CompactCommand}"
                            IsEnabled="{Binding CanRun}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Shrink}"
                                                      Style="{StaticResource Docker.ActionButtonContent}" />
                            <TextBlock Text="Сжать диск Docker"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
