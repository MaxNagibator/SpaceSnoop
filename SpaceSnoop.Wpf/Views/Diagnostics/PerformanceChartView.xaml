<UserControl x:Class="SpaceSnoop.Wpf.Views.Diagnostics.PerformanceChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:diagnostics="clr-namespace:SpaceSnoop.Wpf.Views.Diagnostics"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PerformanceChartViewModel}"
             d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0"
                   Margin="0,0,0,6"
                   Visibility="{Binding Data.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0">
                <Line X1="0"
                      Y1="0"
                      X2="16"
                      Y2="0"
                      Stroke="{DynamicResource Accent.Primary}"
                      StrokeThickness="1.5"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0" />

                <TextBlock Text="{Binding DelayText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0">
                <Line X1="0"
                      Y1="0"
                      X2="16"
                      Y2="0"
                      Stroke="{DynamicResource State.Info}"
                      StrokeThickness="1"
                      StrokeDashArray="3 3"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0" />

                <TextBlock Text="{Binding MemoryText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0">
                <Line X1="0"
                      Y1="0"
                      X2="16"
                      Y2="0"
                      Stroke="{DynamicResource State.Warning}"
                      StrokeThickness="1"
                      StrokeDashArray="2 4"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0" />

                <TextBlock Text="{Binding ThresholdText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0">
                <Rectangle Width="16"
                           Height="10"
                           Fill="{DynamicResource Accent.Soft}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <TextBlock Text="шла операция"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding WindowText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center" />
        </WrapPanel>

        <Border Grid.Row="1"
                Height="120"
                Background="{DynamicResource Bg.SurfaceAlt}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}"
                ClipToBounds="True"
                Focusable="True"
                AutomationProperties.Name="График производительности"
                AutomationProperties.HelpText="{Binding ChartDescription}">
            <Border.ToolTip>
                <TextBlock Text="{Binding ChartDescription}"
                           MaxWidth="420"
                           TextWrapping="Wrap" />
            </Border.ToolTip>

            <Grid>
                <diagnostics:PerformanceChartCanvas Data="{Binding Data}"
                                                    DelayBrush="{DynamicResource Accent.Primary}"
                                                    MemoryBrush="{DynamicResource State.Info}"
                                                    BandBrush="{DynamicResource Accent.Soft}"
                                                    ThresholdBrush="{DynamicResource State.Warning}"
                                                    BaselineBrush="{DynamicResource Border.Subtle}" />

                <TextBlock Text="Замеров пока нет – график появится через несколько секунд"
                           Style="{StaticResource TextBlock.Subtle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="{Binding Data.HasData, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding OperationsText}"
                   Style="{StaticResource TextBlock.Subtle}"
                   Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding OperationsText, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
    </Grid>
</UserControl>
