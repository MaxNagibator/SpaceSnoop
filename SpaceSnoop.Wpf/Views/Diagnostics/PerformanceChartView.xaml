<UserControl x:Class="SpaceSnoop.Wpf.Views.Diagnostics.PerformanceChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:diagnostics="clr-namespace:SpaceSnoop.Wpf.Views.Diagnostics"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PerformanceChartViewModel}"
             d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,6">
            <Border DockPanel.Dock="Right"
                    Background="{DynamicResource Bg.SurfaceAlt}"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource RadioButton.Segment}"
                                 Content="30 с"
                                 IsChecked="{Binding Window, Converter={StaticResource EnumToBoolean}, ConverterParameter=Seconds30}"
                                 ToolTip="Показать последние 30 секунд"
                                 AutomationProperties.Name="Окно графика: 30 секунд" />

                    <RadioButton Style="{StaticResource RadioButton.Segment}"
                                 Content="1 мин"
                                 IsChecked="{Binding Window, Converter={StaticResource EnumToBoolean}, ConverterParameter=Seconds60}"
                                 ToolTip="Показать последнюю минуту"
                                 AutomationProperties.Name="Окно графика: 1 минута" />

                    <RadioButton Style="{StaticResource RadioButton.Segment}"
                                 Content="5 мин"
                                 IsChecked="{Binding Window, Converter={StaticResource EnumToBoolean}, ConverterParameter=Seconds300}"
                                 ToolTip="Показать все накопленные замеры – кольцо держит 5 минут"
                                 AutomationProperties.Name="Окно графика: 5 минут" />
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding WindowText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Visibility="{Binding Data.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding Data.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <iconPacks:PackIconLucide Width="14"
                                          Height="14"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0">
                    <iconPacks:PackIconLucide.Style>
                        <Style TargetType="iconPacks:PackIconLucide">
                            <Setter Property="Kind"
                                    Value="{x:Static iconPacks:PackIconLucideKind.Activity}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Fg.Muted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.HasHitches}"
                                             Value="True">
                                    <Setter Property="Kind"
                                            Value="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource State.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconLucide.Style>
                </iconPacks:PackIconLucide>

                <TextBlock Text="{Binding VerdictText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource TextBlock.Subtle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.HasHitches}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource State.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Height="{Binding ChartHeight}"
                Background="{DynamicResource Bg.SurfaceAlt}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}"
                ClipToBounds="True"
                Focusable="True"
                AutomationProperties.Name="График производительности"
                AutomationProperties.HelpText="{Binding ChartDescription}">
            <Grid>
                <diagnostics:PerformanceChartCanvas Data="{Binding Data}"
                                                    Margin="10,8"
                                                    DelayBrush="{DynamicResource Accent.Primary}"
                                                    MemoryBrush="{DynamicResource State.Info}"
                                                    BandBrush="{DynamicResource Accent.Soft}"
                                                    ThresholdBrush="{DynamicResource State.Warning}"
                                                    BaselineBrush="{DynamicResource Border.Subtle}"
                                                    LabelBrush="{DynamicResource Fg.Muted}"
                                                    SurfaceBrush="{DynamicResource Bg.Surface}"
                                                    TextBrush="{DynamicResource Fg.Primary}"
                                                    ToolTip="{Binding ChartDescription}" />

                <TextBlock Text="Замеров пока нет – график появится через несколько секунд"
                           Style="{StaticResource TextBlock.Subtle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="{Binding Data.HasData, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2"
                   Margin="0,6,0,0"
                   Visibility="{Binding Data.HasData, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding MemoryText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="12,0,0,0" />

            <TextBlock Text="{Binding OperationsText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
