<UserControl x:Class="SpaceSnoop.Wpf.Views.About.AboutFeaturesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.About"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/About/AboutResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="Что умеет шнырь"
                       Style="{StaticResource About.SectionTitle}" />

            <UniformGrid Columns="2"
                         Margin="0,14,-10,0">
                <Border Style="{StaticResource About.FeatureCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.HardDrive}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Text="Сканирование"
                                       Style="{StaticResource About.SectionTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            Text="Дерево занятого места, где жирные папки краснеют от стыда по доле размера, или карта-treemap – те же тяжёлые ветки плитками по площади. Помечаешь хлам – и он улетает в корзину, без членовредительства."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource About.FeatureCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRightLeft}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Text="Синхронизация"
                                       Style="{StaticResource About.SectionTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            Text="Сводит две папки лицом к лицу: цветом видно, кто где лишний, изменённые сверяются по хешу, а перенос – в любую из трёх сторон."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource About.FeatureCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Container}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Text="Docker"
                                       Style="{StaticResource About.SectionTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            Text="Показывает, сколько диска отъел Docker – образы, контейнеры, тома, кэш сборки – и чистит лишнее: прунит мусор, сносит объекты по одному, жмёт VHDX. Безвозвратно, мимо корзины."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource About.FeatureCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ScrollText}"
                                                      Style="{StaticResource About.FeatureIcon}"
                                                      Margin="0,0,10,0" />
                            <TextBlock Text="Логи"
                                       Style="{StaticResource About.SectionTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            Text="Живой поток событий с фильтрами по уровню, источнику и подстроке. Что-то пошло не так – собери отчёт об ошибке одной кнопкой."
                            Style="{StaticResource TextBlock.Subtle}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
