<UserControl x:Class="SpaceSnoop.Wpf.Views.About.AboutHeroCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.About"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignWidth="900">

    <Border Style="{StaticResource Card}"
            Margin="0,0,0,10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="{DynamicResource Radius.M}"
                        Background="{DynamicResource Bg.SurfaceAlt}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/SpaceSnoop.Wpf;component/icon.ico"
                           Width="36"
                           Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AppName}"
                                   Style="{StaticResource TextBlock.Display}"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge.Info}"
                                VerticalAlignment="Center"
                                Margin="12,4,0,0">
                            <TextBlock Text="{Binding Version}"
                                       FontFamily="{DynamicResource Font.Mono}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Tagline}"
                               Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource TextBlock.Subtle}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,18,0,0">
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding OpenRepositoryCommand}"
                        ToolTip="Открыть репозиторий на GitHub">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Github}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                        <TextBlock Text="Репозиторий"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding OpenReleasesCommand}"
                        Margin="10,0,0,0"
                        ToolTip="Список выпусков на GitHub">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Tag}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                        <TextBlock Text="Релизы"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Base}"
                        Command="{Binding ReportIssueCommand}"
                        Margin="10,0,0,0"
                        ToolTip="Открыть форму issue с метаданными среды и хвостом лога">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Bug}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                        <TextBlock Text="Нашёл баг?"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
