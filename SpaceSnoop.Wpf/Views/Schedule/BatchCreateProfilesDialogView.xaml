<UserControl x:Class="SpaceSnoop.Wpf.Views.Schedule.BatchCreateProfilesDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Schedule"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Views.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BatchCreateProfilesDialogViewModel}"
             d:DesignHeight="560"
             d:DesignWidth="720"
             Width="720"
             AutomationProperties.Name="{Binding Title}">

    <UserControl.Resources>
        <Style x:Key="EndpointChip"
               TargetType="Border">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="CornerRadius"
                    Value="11" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.CopyPlus}"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource Accent.Primary}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource DialogTitle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0">
            <TextBlock Text="Каждая подпапка источника превращается в профиль с зеркальным приёмником."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Border Style="{StaticResource EndpointChip}"
                            Background="{DynamicResource State.SuccessSoft}"
                            BorderBrush="{DynamicResource State.Success}"
                            ToolTip="Родитель-источник">
                        <TextBlock Text="Л"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource State.Success}" />
                    </Border>

                    <Button HorizontalAlignment="Center"
                            Cursor="Hand"
                            Margin="0,5"
                            Command="{Binding CycleModeCommand}"
                            ToolTip="{Binding DirectionHint}"
                            AutomationProperties.Name="{Binding DirectionHint}">
                        <Button.InputBindings>
                            <MouseBinding MouseAction="RightClick"
                                          Command="{Binding SwapPathsCommand}" />
                        </Button.InputBindings>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Circle"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        Background="{DynamicResource Accent.Soft}"
                                        BorderBrush="{DynamicResource Accent.Primary}">
                                    <iconPacks:PackIconLucide x:Name="Arrow"
                                                              Kind="{Binding DirectionIconKind}"
                                                              Width="14"
                                                              Height="14"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Accent.Primary}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Circle"
                                                Property="Background"
                                                Value="{DynamicResource Accent.Primary}" />
                                        <Setter TargetName="Arrow"
                                                Property="Foreground"
                                                Value="{DynamicResource Accent.Soft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Style="{StaticResource EndpointChip}"
                            Background="{DynamicResource State.InfoSoft}"
                            BorderBrush="{DynamicResource State.Info}"
                            ToolTip="Родитель-приёмник">
                        <TextBlock Text="П"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource State.Info}" />
                    </Border>
                </StackPanel>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding SourceParent, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:PathSuggest.Enabled="{Binding PathSuggest}"
                         Style="{StaticResource TextBox.Toolbar}"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Родитель-источник"
                         ToolTip="Родитель-источник" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding BrowseSourceCommand}"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="10,6"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Выбрать родителя-источник"
                        ToolTip="Обзор">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                              Width="14"
                                              Height="14" />
                </Button>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding DestParent, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:PathSuggest.Enabled="{Binding PathSuggest}"
                         Style="{StaticResource TextBox.Toolbar}"
                         VerticalAlignment="Center"
                         Margin="0,16,0,0"
                         AutomationProperties.Name="Родитель-приёмник"
                         ToolTip="Родитель-приёмник" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding BrowseDestCommand}"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="10,6"
                        Margin="8,16,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Выбрать родителя-приёмник"
                        ToolTip="Обзор">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                              Width="14"
                                              Height="14" />
                </Button>
            </Grid>
        </StackPanel>

        <views:StretchWrapPanel Grid.Row="2"
                                Margin="0,14,0,0"
                                ItemWidth="240">
            <ListBox Style="{StaticResource ListBox.Segmented}"
                     ItemsSource="{Binding Modes}"
                     SelectedIndex="{Binding SelectedModeIndex}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,8"
                     AutomationProperties.Name="Направление синхронизации" />
            <ListBox Style="{StaticResource ListBox.Segmented}"
                     ItemsSource="{Binding Winners}"
                     SelectedIndex="{Binding SelectedWinnerIndex}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,8"
                     Visibility="{Binding WinnerApplicable, Converter={StaticResource BoolToVisibility}}"
                     ToolTip="Победитель (двусторонний): решает изменённые файлы; при зеркале – что удалять на проигравшей стороне."
                     AutomationProperties.Name="Победитель в двустороннем режиме" />
            <CheckBox Content="Зеркало"
                      IsChecked="{Binding Mirror}"
                      IsEnabled="{Binding MirrorApplicable}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,8" />
            <CheckBox Content="Выбрать все"
                      IsChecked="{Binding AllSelected}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,8"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox views:StretchWrapPanel.Stretch="True"
                      views:StretchWrapPanel.StretchWidth="150"
                      MinWidth="150"
                      Style="{StaticResource ComboBox.Form}"
                      ItemsSource="{Binding SortOptions}"
                      SelectedIndex="{Binding SelectedSort}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,8"
                      AutomationProperties.Name="Сортировка пар"
                      ToolTip="Сортировка пар"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />
            <TextBox views:StretchWrapPanel.Stretch="True"
                     Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBox.Toolbar}"
                     VerticalAlignment="Center"
                     Margin="0,0,0,8"
                     AutomationProperties.Name="Исключения"
                     ToolTip="Исключения (через запятую)" />
        </views:StretchWrapPanel>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                MinHeight="120"
                MaxHeight="280">
            <Grid>
                <TextBlock Text="Укажите родительские каталоги – ниже появятся пары."
                           Style="{StaticResource TextBlock.Subtle}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}" />

                <ListBox ItemsSource="{Binding Rows}"
                         AutomationProperties.Name="Пары профилей"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Include}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Создавать профиль {0}'}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource Fg.Primary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Left, Mode=OneWay}" />
                                        <Run Text="→" />
                                        <Run Text="{Binding Right, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="уже есть"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource State.Warning}"
                                           Visibility="{Binding AlreadyExists, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource TextBlock.Subtle}"
                       Text="{Binding SelectionSummary}"
                       Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding CreateCommand}"
                        Content="{Binding CreateCaption}"
                        MinWidth="120"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="14,6"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
