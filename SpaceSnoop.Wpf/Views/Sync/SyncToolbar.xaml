<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:sync="clr-namespace:SpaceSnoop.Wpf.Views.Sync"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Sync/SyncQuickProfileTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MirrorToggle"
                   TargetType="ToggleButton"
                   BasedOn="{StaticResource ToggleButton.Toolbar}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Setup.MirrorDeletes}"
                                 Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource State.ErrorSoft}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource State.Error}" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource State.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Storyboard x:Key="LabelShow">
                <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                 To="1"
                                 Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 To="1"
                                 Duration="0:0:0.18" />
            </Storyboard>

            <Storyboard x:Key="LabelHide">
                <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                 To="0"
                                 Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 To="0"
                                 Duration="0:0:0.18" />
            </Storyboard>

            <Style x:Key="SyncDeleteMark"
                   TargetType="iconPacks:PackIconLucide">
                <Setter Property="Width"
                        Value="13" />
                <Setter Property="Height"
                        Value="13" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="Margin"
                        Value="8,0,0,0" />
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ledger.SyncIsDestructive}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompareLabel"
                   TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ledger.SyncIsPrimary}"
                                 Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource LabelHide}" />
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard Storyboard="{StaticResource LabelShow}" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SyncLabel"
                   TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ledger.SyncIsPrimary}"
                                 Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource LabelShow}" />
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard Storyboard="{StaticResource LabelHide}" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Padding="14,12"
            Margin="0,0,0,10">
        <StackPanel>
            <sync:SyncEndpointsRow />

            <views:StretchWrapPanel Margin="0,12,0,0"
                                    ItemWidth="240">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding Operations.CompareCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,8"
                        ToolTip="{Binding Ledger.CompareCommandHint}"
                        AutomationProperties.Name="Сравнить каталоги">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitCompare}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Сравнить"
                                   Padding="6,0,0,0"
                                   Style="{StaticResource CompareLabel}">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="1" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding Operations.SyncCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,8"
                        ToolTip="{Binding Ledger.SyncCommandHint}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Синхронизировать каталоги">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{Binding Setup.DirectionIconKind}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Синхронизировать"
                                   Padding="6,0,0,0"
                                   Opacity="0"
                                   Style="{StaticResource SyncLabel}">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="0" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Style="{StaticResource SyncDeleteMark}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding Operations.HashCommand}"
                        MinWidth="0"
                        Padding="9,0"
                        VerticalAlignment="Center"
                        Margin="0,0,16,8"
                        ToolTip="Сверить изменённые файлы по содержимому"
                        AutomationProperties.Name="Сверить хеши изменённых файлов">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Fingerprint}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Хеши"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="MoreToggle"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              MinWidth="0"
                              Padding="9,0"
                              VerticalAlignment="Center"
                              Margin="0,0,16,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ellipsis}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Ещё"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Grid views:StretchWrapPanel.Stretch="True"
                      views:StretchWrapPanel.StretchWidth="360"
                      VerticalAlignment="Center"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="6,3"
                            CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Bg.Surface}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Visibility="{Binding Setup.ShowConflictResolvers, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Разрешить все спорные элементы разом">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitMerge}"
                                                      Width="13"
                                                      Height="13"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,8,0"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding Operations.ResolveAllToRightCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    Foreground="{DynamicResource Sync.LeftOnly}"
                                    ToolTip="Все спорные – слева направо"
                                    AutomationProperties.Name="Все спорные – слева направо">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding Operations.ResolveAllToLeftCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    Foreground="{DynamicResource State.Info}"
                                    ToolTip="Все спорные – справа налево"
                                    AutomationProperties.Name="Все спорные – справа налево">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding Operations.ResolveAllSkipCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    ToolTip="Пропустить все спорные"
                                    AutomationProperties.Name="Пропустить все спорные">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding Setup.Profiles.SaveProfileCommand}"
                                Width="32"
                                MinHeight="{DynamicResource Control.Height.Default}"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                ToolTip="Сохранить текущие параметры новым профилем"
                                AutomationProperties.Name="Сохранить текущие параметры новым профилем">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Plus}"
                                                      Width="14"
                                                      Height="14" />
                        </Button>

                        <ComboBox ItemsSource="{Binding Setup.Profiles.Items}"
                                  Grid.Column="1"
                                  SelectedItem="{Binding Setup.Profiles.SelectedProfile}"
                                  Style="{StaticResource ComboBox.Toolbar}"
                                  ItemTemplate="{StaticResource SyncQuickProfileTemplate}"
                                  VerticalAlignment="Center"
                                  ToolTip="Профиль синхронизации" />
                    </Grid>
                </Grid>
            </views:StretchWrapPanel>

            <Popup x:Name="MorePopup"
                   PlacementTarget="{Binding ElementName=MoreToggle}"
                   Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=MoreToggle, Mode=TwoWay}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   HorizontalOffset="0"
                   VerticalOffset="4">
                <Border Background="{DynamicResource Bg.Surface}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Padding="12"
                        MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="Направление"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding Setup.Modes}"
                                 SelectedIndex="{Binding Setup.SelectedModeIndex}"
                                 Style="{StaticResource ListBox.Segmented}"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Направление синхронизации" />
                        <StackPanel Visibility="{Binding Setup.IsBidirectional, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Победитель"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,12,0,4" />
                            <ListBox ItemsSource="{Binding Setup.Winners}"
                                     SelectedIndex="{Binding Setup.SelectedWinnerIndex}"
                                     Style="{StaticResource ListBox.Segmented}"
                                     HorizontalAlignment="Stretch"
                                     ToolTip="{Binding Setup.WinnerHint}"
                                     AutomationProperties.Name="Победитель в двустороннем режиме" />
                        </StackPanel>
                        <ToggleButton x:Name="MirrorButton"
                                      Style="{StaticResource MirrorToggle}"
                                      IsChecked="{Binding Setup.Mirror}"
                                      IsEnabled="{Binding Setup.MirrorApplicable}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Margin="0,12,0,0"
                                      ToolTip="{Binding Setup.MirrorHint}"
                                      AutomationProperties.Name="{Binding Setup.MirrorHint}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FlipHorizontal2}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Зеркало"
                                           VerticalAlignment="Center" />
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                          Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Center"
                                                          Margin="7,0,0,0"
                                                          Foreground="{DynamicResource State.Error}"
                                                          Visibility="{Binding Setup.MirrorDeletes, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding Setup.Verify}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Margin="0,8,0,0"
                                      ToolTip="После синхронизации сверять затронутые файлы (размер + дата) без полного пересравнения"
                                      AutomationProperties.Name="Проверять результат после синхронизации">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ShieldCheck}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Проверять"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock Text="Коммитов в истории Git"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:SyncGitViewModel.GitHistoryCounts}"
                                  SelectedItem="{Binding Git.GitHistoryCount}"
                                  Style="{StaticResource ComboBox.Toolbar}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip="Сколько последних коммитов показывать в раскрытой Git-полоске" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding Export.ExportComparisonCommand}"
                                MinWidth="0"
                                Padding="9,0"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                ToolTip="Выгрузить результат сравнения в JSON – параметры, сводку, список различий, состояние Git"
                                AutomationProperties.Name="Экспорт сравнения в JSON">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FileBraces}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Экспорт сравнения"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Исключения"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,12,0,4" />
                        <Grid HorizontalAlignment="Stretch">
                            <TextBox Text="{Binding Setup.Exclusions, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.IconField}"
                                     Tag="{x:Static iconPacks:PackIconLucideKind.Funnel}"
                                     ToolTip="Исключения: глоб-шаблоны через запятую, напр. bin,obj,*.tmp" />
                            <TextBlock Text="bin,obj,*.tmp"
                                       Margin="36,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Setup.ExclusionsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
