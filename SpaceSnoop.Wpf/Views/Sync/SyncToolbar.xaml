<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <Style x:Key="EndpointChip"
               TargetType="Border">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="CornerRadius"
                    Value="11" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Padding="14,12"
            Margin="0,0,0,10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Rectangle Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="0"
                           Width="2"
                           HorizontalAlignment="Center"
                           Margin="0,17,0,17"
                           Fill="{DynamicResource Border.Default}" />

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource EndpointChip}"
                        Background="{DynamicResource State.SuccessSoft}"
                        BorderBrush="{DynamicResource State.Success}"
                        ToolTip="Левая сторона">
                    <TextBlock Text="Л"
                               FontWeight="Bold"
                               FontSize="{DynamicResource Font.Size.XS}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource State.Success}" />
                </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent.Primary}"
                        ToolTip="Направление синхронизации">
                    <iconPacks:PackIconLucide Kind="{Binding DirectionIconKind}"
                                              Width="11"
                                              Height="11"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource Accent.Primary}" />
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource EndpointChip}"
                        Background="{DynamicResource State.InfoSoft}"
                        BorderBrush="{DynamicResource State.Info}"
                        ToolTip="Правая сторона">
                    <TextBlock Text="П"
                               FontWeight="Bold"
                               FontSize="{DynamicResource Font.Size.XS}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource State.Info}" />
                </Border>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBox.Toolbar}"
                         Margin="10,0,8,4"
                         ToolTip="Каталог слева" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding BrowseLeftCommand}"
                        Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Обзор" />
                    </StackPanel>
                </Button>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBox.Toolbar}"
                         Margin="10,4,8,0"
                         ToolTip="Каталог справа" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding BrowseRightCommand}"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Обзор" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding CompareCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitCompare}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Сравнить" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}"
                            Command="{Binding HashCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Сверить изменённые файлы по содержимому">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Fingerprint}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Хеши" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding SyncCommand}"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRightLeft}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Синхронизировать" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Padding="6,3"
                            CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Bg.Surface}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            ToolTip="Разрешить все спорные элементы разом">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitMerge}"
                                                      Width="13"
                                                      Height="13"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,8,0"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ResolveAllToRightCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    Foreground="{DynamicResource State.Success}"
                                    ToolTip="Все спорные — слева направо"
                                    AutomationProperties.Name="Все спорные — слева направо">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ResolveAllToLeftCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    Foreground="{DynamicResource State.Info}"
                                    ToolTip="Все спорные — справа налево"
                                    AutomationProperties.Name="Все спорные — справа налево">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ResolveAllSkipCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    ToolTip="Пропустить все спорные"
                                    AutomationProperties.Name="Пропустить все спорные">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Modes}"
                              SelectedIndex="{Binding SelectedModeIndex}"
                              Style="{StaticResource ComboBox.Toolbar}"
                              MinWidth="172"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              ToolTip="Направление синхронизации" />
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Funnel}"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource Fg.Muted}" />
                    <TextBlock Text="Исключения"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Style="{StaticResource TextBlock.Subtle}" />
                    <TextBox Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Toolbar}"
                             Width="200"
                             VerticalAlignment="Center"
                             ToolTip="Глоб-шаблоны через запятую, напр. bin,obj,*.tmp" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox Content="Показывать одинаковые"
                              IsChecked="{Binding ShowIdentical}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Размеры"
                              IsChecked="{Binding ShowSizes}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox Content="Изменён"
                              IsChecked="{Binding ShowModified}"
                              VerticalAlignment="Center"
                              ToolTip="Показывать время последнего изменения файла" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
