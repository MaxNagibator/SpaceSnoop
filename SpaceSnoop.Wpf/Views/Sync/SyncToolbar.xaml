<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Views.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <Style x:Key="EndpointChip"
               TargetType="Border">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="CornerRadius"
                    Value="11" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="MirrorToggle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource ToggleButton.Toolbar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MirrorDeletes}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource State.ErrorSoft}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Error}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="LabelShow">
            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                             To="1"
                             Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.18" />
        </Storyboard>

        <Storyboard x:Key="LabelHide">
            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                             To="0"
                             Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.18" />
        </Storyboard>

        <Style x:Key="CompareLabel"
               TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncIsPrimary}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource LabelHide}" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource LabelShow}" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SyncLabel"
               TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncIsPrimary}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource LabelShow}" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource LabelHide}" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Padding="14,12"
            Margin="0,0,0,10">
        <StackPanel>
            <views:StretchWrapPanel ItemWidth="400">
                <DockPanel views:StretchWrapPanel.Stretch="True"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8">
                    <Border DockPanel.Dock="Left"
                            Style="{StaticResource EndpointChip}"
                            Margin="0,0,8,0"
                            Background="{DynamicResource State.SuccessSoft}"
                            BorderBrush="{DynamicResource State.Success}"
                            ToolTip="Левая сторона">
                        <TextBlock Text="Л"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource State.Success}" />
                    </Border>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding BrowseLeftCommand}"
                            Padding="9,0"
                            MinWidth="0"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Обзор"
                            AutomationProperties.Name="Обзор каталога слева">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                                  Width="15"
                                                  Height="15" />
                    </Button>
                    <Grid VerticalAlignment="Center">
                        <TextBox Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:PathSuggest.Enabled="{Binding Operations.SyncPathSuggest}"
                                 Style="{StaticResource TextBox.Toolbar}"
                                 ToolTip="Каталог слева" />
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                  Width="14"
                                                  Height="14"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  IsHitTestVisible="False"
                                                  Foreground="{DynamicResource State.Error}"
                                                  ToolTip="Каталог не найден"
                                                  Visibility="{Binding LeftPathInvalid, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </Grid>
                </DockPanel>

                <Button VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Margin="0,0,12,8"
                        Command="{Binding CycleModeCommand}"
                        ToolTip="{Binding DirectionHint}"
                        AutomationProperties.Name="{Binding DirectionHint}">
                    <Button.InputBindings>
                        <MouseBinding MouseAction="RightClick"
                                      Command="{Binding SwapPathsCommand}" />
                    </Button.InputBindings>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Circle"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="11"
                                    BorderThickness="1"
                                    Background="{DynamicResource Accent.Soft}"
                                    BorderBrush="{DynamicResource Accent.Primary}">
                                <iconPacks:PackIconLucide x:Name="Arrow"
                                                          Kind="{Binding DirectionIconKind}"
                                                          Width="13"
                                                          Height="13"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource Accent.Primary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Circle"
                                            Property="Background"
                                            Value="{DynamicResource Accent.Primary}" />
                                    <Setter TargetName="Arrow"
                                            Property="Foreground"
                                            Value="{DynamicResource Accent.Soft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <DockPanel views:StretchWrapPanel.Stretch="True"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8">
                    <Border DockPanel.Dock="Right"
                            Style="{StaticResource EndpointChip}"
                            Margin="8,0,0,0"
                            Background="{DynamicResource State.InfoSoft}"
                            BorderBrush="{DynamicResource State.Info}"
                            ToolTip="Правая сторона">
                        <TextBlock Text="П"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource State.Info}" />
                    </Border>
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding BrowseRightCommand}"
                            Padding="9,0"
                            MinWidth="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            ToolTip="Обзор"
                            AutomationProperties.Name="Обзор каталога справа">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                                  Width="15"
                                                  Height="15" />
                    </Button>
                    <Grid VerticalAlignment="Center">
                        <TextBox Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:PathSuggest.Enabled="{Binding Operations.SyncPathSuggest}"
                                 Style="{StaticResource TextBox.Toolbar}"
                                 ToolTip="Каталог справа" />
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                  Width="14"
                                                  Height="14"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  IsHitTestVisible="False"
                                                  Foreground="{DynamicResource State.Error}"
                                                  ToolTip="Каталог не найден"
                                                  Visibility="{Binding RightPathInvalid, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </Grid>
                </DockPanel>
            </views:StretchWrapPanel>

            <views:StretchWrapPanel Margin="0,12,0,0"
                                    ItemWidth="240">
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding CompareCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,8"
                        ToolTip="Сравнить">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitCompare}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Сравнить"
                                   Padding="6,0,0,0"
                                   Style="{StaticResource CompareLabel}">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="1" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding SyncCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,8"
                        ToolTip="Синхронизировать">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRightLeft}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Синхронизировать"
                                   Padding="6,0,0,0"
                                   Opacity="0"
                                   Style="{StaticResource SyncLabel}">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="0" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource MirrorToggle}"
                              IsChecked="{Binding Mirror}"
                              IsEnabled="{Binding MirrorApplicable}"
                              MinWidth="0"
                              Padding="9,0"
                              VerticalAlignment="Center"
                              Margin="0,0,16,8"
                              ToolTip="{Binding MirrorHint}"
                              AutomationProperties.Name="{Binding MirrorHint}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FlipHorizontal2}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Зеркало"
                                   VerticalAlignment="Center" />
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                  Width="13"
                                                  Height="13"
                                                  VerticalAlignment="Center"
                                                  Margin="7,0,0,0"
                                                  Foreground="{DynamicResource State.Error}"
                                                  Visibility="{Binding MirrorDeletes, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding HashCommand}"
                        MinWidth="0"
                        Padding="9,0"
                        VerticalAlignment="Center"
                        Margin="0,0,16,8"
                        ToolTip="Сверить изменённые файлы по содержимому"
                        AutomationProperties.Name="Сверить хеши изменённых файлов">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Fingerprint}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Хеши"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="MoreToggle"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              MinWidth="0"
                              Padding="9,0"
                              VerticalAlignment="Center"
                              Margin="0,0,16,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ellipsis}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Ещё"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Grid views:StretchWrapPanel.Stretch="True"
                      views:StretchWrapPanel.StretchWidth="360"
                      VerticalAlignment="Center"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="6,3"
                            CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Bg.Surface}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Visibility="{Binding ShowConflictResolvers, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Разрешить все спорные элементы разом">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitMerge}"
                                                      Width="13"
                                                      Height="13"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,8,0"
                                                      Foreground="{DynamicResource Fg.Muted}" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ResolveAllToRightCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    Foreground="{DynamicResource State.Success}"
                                    ToolTip="Все спорные – слева направо"
                                    AutomationProperties.Name="Все спорные – слева направо">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ResolveAllToLeftCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    Foreground="{DynamicResource State.Info}"
                                    ToolTip="Все спорные – справа налево"
                                    AutomationProperties.Name="Все спорные – справа налево">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ResolveAllSkipCommand}"
                                    Padding="9,2"
                                    MinHeight="26"
                                    ToolTip="Пропустить все спорные"
                                    AutomationProperties.Name="Пропустить все спорные">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                          Width="14"
                                                          Height="14" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding Profiles.SaveProfileCommand}"
                                Width="32"
                                MinHeight="{DynamicResource Control.Height.Default}"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                ToolTip="Сохранить текущие параметры новым профилем"
                                AutomationProperties.Name="Сохранить текущие параметры новым профилем">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Plus}"
                                                      Width="14"
                                                      Height="14" />
                        </Button>

                        <ComboBox ItemsSource="{Binding Profiles.Items}"
                                  Grid.Column="1"
                                  SelectedItem="{Binding Profiles.SelectedProfile}"
                                  Style="{StaticResource ComboBox.Toolbar}"
                                  VerticalAlignment="Center"
                                  ToolTip="Профиль синхронизации">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SyncQuickProfileItem}">
                                    <Grid MinWidth="190">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0"
                                                   Visibility="{Binding CanConfirmRename, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextBox.Toolbar}"
                                                 MinWidth="128"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Имя профиля"
                                                 AutomationProperties.Name="Имя профиля"
                                                 Visibility="{Binding CanConfirmRename, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                            Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding CanShowActions, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding RequestUpdateCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Обновить профиль текущими параметрами"
                                                        AutomationProperties.Name="Обновить профиль текущими параметрами">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.Save}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding RequestRenameCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Переименовать профиль"
                                                        AutomationProperties.Name="Переименовать профиль">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.Pencil}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding RequestDeleteCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Удалить профиль"
                                                        AutomationProperties.Name="Удалить профиль">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding CanConfirmUpdate, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding ConfirmUpdateCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Подтвердить обновление"
                                                        AutomationProperties.Name="Подтвердить обновление">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.Check}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding CancelUpdateCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Отменить обновление"
                                                        AutomationProperties.Name="Отменить обновление">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding CanConfirmRename, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding ConfirmRenameCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Сохранить имя"
                                                        AutomationProperties.Name="Сохранить имя">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.Check}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding CancelRenameCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Отменить переименование"
                                                        AutomationProperties.Name="Отменить переименование">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding CanConfirmDelete, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding ConfirmDeleteCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Подтвердить удаление"
                                                        AutomationProperties.Name="Подтвердить удаление">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.Check}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding CancelDeleteCommand}"
                                                        Padding="6,3"
                                                        MinHeight="24"
                                                        ToolTip="Отменить удаление"
                                                        AutomationProperties.Name="Отменить удаление">
                                                    <iconPacks:PackIconLucide
                                                        Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                        Width="13"
                                                        Height="13" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Grid>
            </views:StretchWrapPanel>

            <Popup PlacementTarget="{Binding ElementName=MoreToggle}"
                   Placement="Bottom"
                   IsOpen="{Binding IsChecked, ElementName=MoreToggle, Mode=TwoWay}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   HorizontalOffset="0"
                   VerticalOffset="4">
                <Border Background="{DynamicResource Bg.Surface}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.M}"
                        Padding="12"
                        MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="Направление"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding Modes}"
                                 SelectedIndex="{Binding SelectedModeIndex}"
                                 Style="{StaticResource ListBox.Segmented}"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Направление синхронизации" />
                        <StackPanel Visibility="{Binding IsBidirectional, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Победитель"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,12,0,4" />
                            <ListBox ItemsSource="{Binding Winners}"
                                     SelectedIndex="{Binding SelectedWinnerIndex}"
                                     Style="{StaticResource ListBox.Segmented}"
                                     HorizontalAlignment="Stretch"
                                     ToolTip="{Binding WinnerHint}"
                                     AutomationProperties.Name="Победитель в двустороннем режиме" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding Verify}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Margin="0,12,0,0"
                                      ToolTip="После синхронизации сверять затронутые файлы (размер + дата) без полного пересравнения"
                                      AutomationProperties.Name="Проверять результат после синхронизации">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ShieldCheck}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Проверять"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock Text="Коммитов в истории Git"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{x:Static vm:SyncViewModel.GitHistoryCounts}"
                                  SelectedItem="{Binding GitHistoryCount}"
                                  Style="{StaticResource ComboBox.Toolbar}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip="Сколько последних коммитов показывать в раскрытой Git-полоске" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding ExportComparisonCommand}"
                                MinWidth="0"
                                Padding="9,0"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                ToolTip="Выгрузить результат сравнения в JSON – параметры, сводку, список различий, состояние Git"
                                AutomationProperties.Name="Экспорт сравнения в JSON">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FileBraces}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Экспорт сравнения"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Исключения"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   Margin="0,12,0,4" />
                        <Grid HorizontalAlignment="Stretch">
                            <TextBox Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.IconField}"
                                     Tag="{x:Static iconPacks:PackIconLucideKind.Funnel}"
                                     ToolTip="Исключения: глоб-шаблоны через запятую, напр. bin,obj,*.tmp" />
                            <TextBlock Text="bin,obj,*.tmp"
                                       Margin="36,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding ExclusionsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
