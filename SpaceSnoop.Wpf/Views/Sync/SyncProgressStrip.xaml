<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncProgressStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncSessionViewModel}"
             d:DesignWidth="1040">

    <Border DataContext="{Binding Session}"
            Margin="0,0,0,10"
            Padding="16,12">
        <Border.Style>
            <Style TargetType="Border"
                   BasedOn="{StaticResource Card.Inset}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Setter Property="Opacity"
                        Value="0" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="8" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.24" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                     To="0"
                                                     Duration="0:0:0.30">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Center"
                                          Margin="0,0,9,0"
                                          Foreground="{DynamicResource Accent.Primary}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressDetail}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ProgressDetail}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Visibility="{Binding HasProgressRate, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ProgressRateText}"
                               Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding ProgressRemainingText}"
                               ToolTip="Оценка по средней скорости от начала операции">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource StatValue}">
                                <Setter Property="Margin"
                                        Value="12,0,0,0" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressRemainingText}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Height="8"
                             Minimum="0"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        MinHeight="26"
                        VerticalAlignment="Center"
                        ToolTip="Отменить операцию"
                        AutomationProperties.Name="Отменить операцию">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                  Width="12"
                                                  Height="12"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Отмена"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
