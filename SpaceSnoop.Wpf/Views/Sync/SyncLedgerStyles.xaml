<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SpaceSnoop.Wpf.Converters"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <conv:FractionToWidthConverter x:Key="FractionToWidth" />

    <Style x:Key="TallyValue"
           TargetType="TextBlock"
           BasedOn="{StaticResource StatValue}" />

    <Style x:Key="DirTally"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="8,0,0,0" />
        <Setter Property="ToolTip"
                Value="Каталогов с таким же статусом (файлы внутри посчитаны отдельно)" />
    </Style>

    <Style x:Key="DirTallyValue"
           TargetType="TextBlock"
           BasedOn="{StaticResource Caption}" />

    <Style x:Key="LedgerStrip"
           TargetType="Border"
           BasedOn="{StaticResource Card.Inset}">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="MinHeight"
                Value="44" />
        <Setter Property="Visibility"
                Value="Collapsed" />
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="8" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasResult}"
                         Value="True">
                <Setter Property="Visibility"
                        Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.24" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompositionSegment"
           TargetType="Rectangle">
        <Setter Property="Height"
                Value="8" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="FreshIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding NewerIsLeft}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource Sync.LeftOnly}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NewerIsRight}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Info}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FreshValue"
           TargetType="TextBlock"
           BasedOn="{StaticResource TallyValue}">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding NewerIsLeft}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource Sync.LeftOnly}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NewerIsRight}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.Info}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlanVolume"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,20,0" />
        <Setter Property="Visibility"
                Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPlanVolume}"
                         Value="True">
                <Setter Property="Visibility"
                        Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConflictTally"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,20,0" />
        <Setter Property="Visibility"
                Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasConflicts}"
                         Value="True">
                <Setter Property="Visibility"
                        Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlanCopyPart"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,10,0" />
        <Setter Property="Visibility"
                Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPlanCopy}"
                         Value="True">
                <Setter Property="Visibility"
                        Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlanTrashPart"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Visibility"
                Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPlanTrash}"
                         Value="True">
                <Setter Property="Visibility"
                        Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NewerBadge"
           TargetType="StackPanel">
        <Setter Property="Orientation"
                Value="Horizontal" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,20,0" />
        <Setter Property="Visibility"
                Value="Collapsed" />
        <Setter Property="Opacity"
                Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowNewerBadge}"
                         Value="True">
                <Setter Property="Visibility"
                        Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.24" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
