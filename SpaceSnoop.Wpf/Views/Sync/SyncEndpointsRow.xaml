<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncEndpointsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Views.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <Style x:Key="EndpointChip"
               TargetType="Border">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="CornerRadius"
                    Value="11" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
        </Style>
    </UserControl.Resources>

    <views:StretchWrapPanel ItemWidth="400">
        <DockPanel views:StretchWrapPanel.Stretch="True"
                   VerticalAlignment="Center"
                   Margin="0,0,12,8">
            <Border DockPanel.Dock="Left"
                    Style="{StaticResource EndpointChip}"
                    Margin="0,0,8,0"
                    Background="{DynamicResource Accent.Soft}"
                    BorderBrush="{DynamicResource Sync.LeftOnly}"
                    ToolTip="Левая сторона">
                <TextBlock Text="Л"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.XS}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Sync.LeftOnly}" />
            </Border>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding Setup.BrowseLeftCommand}"
                    Padding="9,0"
                    MinWidth="0"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Обзор"
                    AutomationProperties.Name="Обзор каталога слева">
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                          Width="15"
                                          Height="15" />
            </Button>
            <Grid VerticalAlignment="Center">
                <TextBox Text="{Binding Setup.LeftPath, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:PathSuggest.Enabled="{Binding Setup.Preferences.SyncPathSuggest}"
                         Style="{StaticResource TextBox.Toolbar}"
                         ToolTip="Каталог слева" />
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                          Width="14"
                                          Height="14"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsHitTestVisible="False"
                                          Foreground="{DynamicResource State.Error}"
                                          ToolTip="Каталог не найден"
                                          Visibility="{Binding Setup.LeftPathInvalid, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            </Grid>
        </DockPanel>

        <Button views:StretchWrapPanel.Standalone="True"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Cursor="Hand"
                Margin="0,0,12,8"
                Command="{Binding Setup.CycleModeCommand}"
                ToolTip="{Binding Setup.DirectionHint}"
                AutomationProperties.Name="{Binding Setup.DirectionHint}">
            <Button.InputBindings>
                <MouseBinding MouseAction="RightClick"
                              Command="{Binding Setup.SwapPathsCommand}" />
            </Button.InputBindings>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Circle"
                            Width="22"
                            Height="22"
                            CornerRadius="11"
                            BorderThickness="1"
                            Background="{DynamicResource Accent.Soft}"
                            BorderBrush="{DynamicResource Accent.Primary}">
                        <iconPacks:PackIconLucide x:Name="Arrow"
                                                  Kind="{Binding Setup.DirectionIconKind}"
                                                  Width="13"
                                                  Height="13"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Accent.Primary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Circle"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="Arrow"
                                    Property="Foreground"
                                    Value="{DynamicResource Accent.Soft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <DockPanel views:StretchWrapPanel.Stretch="True"
                   VerticalAlignment="Center"
                   Margin="0,0,0,8">
            <Border DockPanel.Dock="Right"
                    Style="{StaticResource EndpointChip}"
                    Margin="8,0,0,0"
                    Background="{DynamicResource State.InfoSoft}"
                    BorderBrush="{DynamicResource State.Info}"
                    ToolTip="Правая сторона">
                <TextBlock Text="П"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.XS}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource State.Info}" />
            </Border>
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding Setup.BrowseRightCommand}"
                    Padding="9,0"
                    MinWidth="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip="Обзор"
                    AutomationProperties.Name="Обзор каталога справа">
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                          Width="15"
                                          Height="15" />
            </Button>
            <Grid VerticalAlignment="Center">
                <TextBox Text="{Binding Setup.RightPath, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:PathSuggest.Enabled="{Binding Setup.Preferences.SyncPathSuggest}"
                         Style="{StaticResource TextBox.Toolbar}"
                         ToolTip="Каталог справа" />
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                          Width="14"
                                          Height="14"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsHitTestVisible="False"
                                          Foreground="{DynamicResource State.Error}"
                                          ToolTip="Каталог не найден"
                                          Visibility="{Binding Setup.RightPathInvalid, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            </Grid>
        </DockPanel>
    </views:StretchWrapPanel>
</UserControl>
