<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncDiffPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Views.Behaviors"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignHeight="480"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <Style x:Key="NodeName"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}"
                             Value="True">
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="LeftOnly">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="RightOnly">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Modified">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Conflict">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Identical">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NodeNameLeft"
               TargetType="TextBlock"
               BasedOn="{StaticResource NodeName}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LeftAbsent}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="TextDecorations"
                            Value="Strikethrough" />
                    <Setter Property="FontWeight"
                            Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NodeNameRight"
               TargetType="TextBlock"
               BasedOn="{StaticResource NodeName}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RightAbsent}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="TextDecorations"
                            Value="Strikethrough" />
                    <Setter Property="FontWeight"
                            Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChevronToggle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Width"
                    Value="14" />
            <Setter Property="Height"
                    Value="14" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name"
                    Value="Развернуть или свернуть каталог" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChevronBd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.S}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ChevronBd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SyncNodeMenu">
            <ContextMenu.Resources>
                <Style x:Key="MenuGlyph"
                       TargetType="iconPacks:PackIconLucide">
                    <Setter Property="Width"
                            Value="14" />
                    <Setter Property="Height"
                            Value="14" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                    <Setter Property="Margin"
                            Value="0,0,9,0" />
                </Style>
            </ContextMenu.Resources>

            <MenuItem
                Command="{Binding PlacementTarget.DataContext.CompareContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanCompareContent, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.GitCompareArrows}"
                                                  Foreground="{DynamicResource State.Info}" />
                        <TextBlock Text="{Binding PlacementTarget.DataContext.CompareContentHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator
                Visibility="{Binding PlacementTarget.DataContext.CanCompareContent, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />

            <MenuItem
                Command="{Binding PlacementTarget.DataContext.CopyToRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanCopyRight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                  Foreground="{DynamicResource State.Success}" />
                        <TextBlock Text="Копировать слева направо"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.CopyToLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanCopyLeft, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                  Foreground="{DynamicResource State.Info}" />
                        <TextBlock Text="Копировать справа налево"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanCycle, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Пропустить (не трогать)"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanDeleteFile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Foreground="{DynamicResource State.Error}" />
                        <TextBlock
                            Text="{Binding PlacementTarget.DataContext.FileDeleteHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirCopyToRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                  Foreground="{DynamicResource State.Success}" />
                        <TextBlock Text="Всё содержимое: слева направо"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirCopyToLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                  Foreground="{DynamicResource State.Info}" />
                        <TextBlock Text="Всё содержимое: справа налево"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirSkipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Всё содержимое: пропустить"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirDeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanDirDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Foreground="{DynamicResource State.Error}" />
                        <TextBlock
                            Text="{Binding PlacementTarget.DataContext.DirDeleteHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator
                Visibility="{Binding PlacementTarget.DataContext.TreeExpansionActionsVisible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.ExpandSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.TreeExpansionActionsVisible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ChevronsUpDown}"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Развернуть эту ветку"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.CollapseSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.TreeExpansionActionsVisible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ChevronsDownUp}"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Свернуть эту ветку"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="DiffRow"
               TargetType="ListBoxItem">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="Padding"
                    Value="6,1" />
            <Setter Property="MinHeight"
                    Value="26" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="ContextMenu"
                    Value="{StaticResource SyncNodeMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="OutcomeBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="RowBd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="RowBd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="RowBd"
                                        Property="BorderThickness"
                                        Value="0,1,0,1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Outcome}"
                                         Value="Applied">
                                <Setter TargetName="OutcomeBar"
                                        Property="Background"
                                        Value="{DynamicResource State.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Outcome}"
                                         Value="Mismatch">
                                <Setter TargetName="OutcomeBar"
                                        Property="Background"
                                        Value="{DynamicResource State.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Outcome}"
                                         Value="Failed">
                                <Setter TargetName="OutcomeBar"
                                        Property="Background"
                                        Value="{DynamicResource State.Error}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Bg.SurfaceMute}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupHeader}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Bg.SurfaceMute}" />
                    <Setter Property="ContextMenu"
                            Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionPill"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Default}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Width"
                    Value="34" />
            <Setter Property="Height"
                    Value="24" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Pill}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceMute}" />
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="Transparent" />
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.7"
                                                         To="1"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut"
                                                          Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.7"
                                                         To="1"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut"
                                                          Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Action}"
                             Value="CopyToRight">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="CopyToLeft">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="DeleteLeft">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="DeleteRight">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="None">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideSize"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="MinWidth"
                    Value="56" />
        </Style>

        <Style x:Key="SideModified"
               TargetType="TextBlock"
               BasedOn="{StaticResource SideSize}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="MinWidth"
                    Value="0" />
        </Style>

        <Style x:Key="SideModifiedLeft"
               TargetType="TextBlock"
               BasedOn="{StaticResource SideModified}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LeftIsNewer}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideModifiedRight"
               TargetType="TextBlock"
               BasedOn="{StaticResource SideModified}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RightIsNewer}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="6,4,18,8"
                  Visibility="{Binding FlatView, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="240"
                      HorizontalAlignment="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.IconField}"
                             Tag="{x:Static iconPacks:PackIconLucideKind.Search}"
                             ToolTip="Фильтр списка по пути файла" />
                    <TextBlock Text="Фильтр по пути"
                               Margin="36,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg.Muted}"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchTextEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <ComboBox Grid.Column="1"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding FlatSort}"
                          Style="{StaticResource ComboBox.Toolbar}"
                          MinWidth="150"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="Сортировка списка">
                    <ComboBoxItem Content="По пути"
                                  Tag="{x:Static vm:SyncFlatSortField.Path}" />
                    <ComboBoxItem Content="По размеру"
                                  Tag="{x:Static vm:SyncFlatSortField.Size}" />
                    <ComboBoxItem Content="По статусу"
                                  Tag="{x:Static vm:SyncFlatSortField.Status}" />
                </ComboBox>

                <ToggleButton Grid.Column="2"
                              Style="{StaticResource ToggleButton.Toolbar}"
                              IsChecked="{Binding FlatSortDescending}"
                              MinWidth="0"
                              Padding="9,0"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="Сортировать по убыванию"
                              AutomationProperties.Name="Сортировать по убыванию">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowDownUp}"
                                              Width="14"
                                              Height="14" />
                </ToggleButton>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="14,6,18,8"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ЛЕВАЯ"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               Text="ДАТА"
                               Style="{StaticResource Caption}"
                               Margin="0,0,18,0"
                               Visibility="{Binding ShowModified, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2"
                               Text="РАЗМЕР"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding ShowSizes, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <iconPacks:PackIconLucide Grid.Column="1"
                                          Kind="{x:Static iconPacks:PackIconLucideKind.MousePointerClick}"
                                          Width="14"
                                          Height="14"
                                          HorizontalAlignment="Center"
                                          Foreground="{DynamicResource Fg.Muted}"
                                          ToolTip="Кружок по центру строки задаёт действие синхронизации – клик циклически переключает копирование / пропуск / удаление."
                                          AutomationProperties.Name="Действие синхронизации" />

                <Grid Grid.Column="2"
                      Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ПРАВАЯ"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               Text="ДАТА"
                               Style="{StaticResource Caption}"
                               Margin="0,0,18,0"
                               Visibility="{Binding ShowModified, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2"
                               Text="РАЗМЕР"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding ShowSizes, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource Border.Subtle}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,4,0,0"
                     Foreground="{DynamicResource Fg.Primary}"
                     MouseDoubleClick="OnRowDoubleClick"
                     ItemContainerStyle="{StaticResource DiffRow}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button x:Name="GitHeader"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ToggleGroupCommand}"
                                    Margin="{Binding IndentMargin}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="4,3"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    ToolTip="Файлы из служебных каталогов (список в настройках) – клик разворачивает или сворачивает группу">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="{Binding ExpandIconKind}"
                                                              Width="13"
                                                              Height="13"
                                                              VerticalAlignment="Center"
                                                              Margin="2,0,8,0"
                                                              Foreground="{DynamicResource Fg.Muted}" />
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              Foreground="{DynamicResource Fg.Muted}" />
                                    <TextBlock Text="{Binding GroupHeaderText}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                </StackPanel>
                            </Button>
                            <Grid x:Name="DiffContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Margin="{Binding IndentMargin}"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ExpanderColumnWidth}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ChevronToggle}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Visibility="{Binding LeftExpanderVisible, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="{Binding ExpandIconKind}"
                                                                  Width="12"
                                                                  Height="12" />
                                    </Button>
                                    <iconPacks:PackIconLucide Grid.Column="1"
                                                              Style="{StaticResource NodeIcon}"
                                                              Visibility="{Binding LeftContentVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="2"
                                               behaviors:PathTrimmer.FullPath="{Binding DisplayName}"
                                               ToolTip="{Binding DisplayName}"
                                               Style="{StaticResource NodeNameLeft}"
                                               Visibility="{Binding LeftContentVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <iconPacks:PackIconLucide Grid.Column="3"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                              Width="12"
                                                              Height="12"
                                                              VerticalAlignment="Center"
                                                              Margin="4,0,4,0"
                                                              Foreground="{DynamicResource State.Error}"
                                                              ToolTip="Конфликт – требуется разрешение">
                                        <iconPacks:PackIconLucide.Style>
                                            <Style TargetType="iconPacks:PackIconLucide">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Conflict">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconLucide.Style>
                                    </iconPacks:PackIconLucide>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding LeftModifiedText}"
                                               Style="{StaticResource SideModifiedLeft}"
                                               Margin="8,0,0,0"
                                               ToolTip="Последнее изменение"
                                               Visibility="{Binding DataContext.ShowModified, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding LeftSizeText}"
                                               Style="{StaticResource SideSize}"
                                               Margin="8,0,6,0"
                                               Visibility="{Binding DataContext.ShowSizes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionPill}"
                                        Command="{Binding CycleActionCommand}"
                                        IsEnabled="{Binding CanCycle}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ToolTip="{Binding ActionHint}"
                                        AutomationProperties.Name="{Binding ActionHint}"
                                        Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconLucide Kind="{Binding ActionIconKind}"
                                                              Width="15"
                                                              Height="15" />
                                </Button>

                                <Grid Grid.Column="2"
                                      Margin="{Binding IndentMargin}"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ExpanderColumnWidth}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ChevronToggle}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Visibility="{Binding RightExpanderVisible, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="{Binding ExpandIconKind}"
                                                                  Width="12"
                                                                  Height="12" />
                                    </Button>
                                    <iconPacks:PackIconLucide Grid.Column="1"
                                                              Style="{StaticResource NodeIcon}"
                                                              Visibility="{Binding RightContentVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="2"
                                               behaviors:PathTrimmer.FullPath="{Binding DisplayName}"
                                               ToolTip="{Binding DisplayName}"
                                               Style="{StaticResource NodeNameRight}"
                                               Visibility="{Binding RightContentVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <iconPacks:PackIconLucide Grid.Column="3"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                              Width="12"
                                                              Height="12"
                                                              VerticalAlignment="Center"
                                                              Margin="4,0,4,0"
                                                              Foreground="{DynamicResource State.Error}"
                                                              ToolTip="Конфликт – требуется разрешение">
                                        <iconPacks:PackIconLucide.Style>
                                            <Style TargetType="iconPacks:PackIconLucide">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Conflict">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconLucide.Style>
                                    </iconPacks:PackIconLucide>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding RightModifiedText}"
                                               Style="{StaticResource SideModifiedRight}"
                                               Margin="8,0,0,0"
                                               ToolTip="Последнее изменение"
                                               Visibility="{Binding DataContext.ShowModified, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding RightSizeText}"
                                               Style="{StaticResource SideSize}"
                                               Margin="8,0,6,0"
                                               Visibility="{Binding DataContext.ShowSizes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGroupHeader}"
                                         Value="True">
                                <Setter TargetName="GitHeader"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="DiffContent"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <keepshell:EmptyState Grid.Row="2"
                                  Icon="GitCompareArrows"
                                  IconSize="40"
                                  Heading="Сравнение ещё не выполнялось"
                                  Description="Укажите два каталога – слева и справа – выберите направление и нажмите «Сравнить». Различия лягут в дерево с цветовой кодировкой статуса и направленными действиями синхронизации."
                                  DescriptionMaxWidth="460"
                                  ActionText="Сравнить"
                                  ActionCommand="{Binding CompareCommand}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}" />

            <Border Grid.Row="3"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SummaryText}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               Foreground="{DynamicResource Fg.Muted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="12,0,0,-4">
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding ExpandAllCommand}"
                                MinWidth="0"
                                Padding="9,0"
                                Margin="0,0,8,4"
                                ToolTip="Развернуть все каталоги в дереве"
                                AutomationProperties.Name="Развернуть все каталоги"
                                Visibility="{Binding FlatView, Converter={StaticResource InverseBoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ChevronsUpDown}"
                                                      Width="14"
                                                      Height="14" />
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding CollapseAllCommand}"
                                MinWidth="0"
                                Padding="9,0"
                                Margin="0,0,8,4"
                                ToolTip="Свернуть все каталоги в дереве"
                                AutomationProperties.Name="Свернуть все каталоги"
                                Visibility="{Binding FlatView, Converter={StaticResource InverseBoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ChevronsDownUp}"
                                                      Width="14"
                                                      Height="14" />
                        </Button>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding FlatView}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      Margin="0,0,8,4"
                                      ToolTip="Плоский список различающихся файлов вместо дерева каталогов"
                                      AutomationProperties.Name="Плоский список файлов вместо дерева">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.List}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Файлы"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding ShowIdentical}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      Margin="0,0,8,4"
                                      ToolTip="Показывать одинаковые файлы"
                                      AutomationProperties.Name="Показывать одинаковые файлы">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Equal}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Одинаковые"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding ShowSizes}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      Margin="0,0,8,4"
                                      ToolTip="Показывать размеры файлов"
                                      AutomationProperties.Name="Показывать размеры файлов">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ruler}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Размер"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding ShowModified}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      Margin="0,0,8,4"
                                      ToolTip="Показывать время последнего изменения файла"
                                      AutomationProperties.Name="Показывать время последнего изменения файла">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clock}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Дата"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding BlankAbsent}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      Margin="0,0,0,4"
                                      ToolTip="Отсутствующую сторону показывать пустой, а не зачёркнутым именем"
                                      AutomationProperties.Name="Отсутствующую сторону показывать пустой">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.EyeOff}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Пустота"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                      IsChecked="{Binding ShowApplied}"
                                      MinWidth="0"
                                      Padding="9,0"
                                      Margin="8,0,0,4"
                                      ToolTip="Показывать строки, успешно применённые при последней синхронизации"
                                      AutomationProperties.Name="Показывать успешно применённые строки">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.CheckCheck}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Применённые"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
