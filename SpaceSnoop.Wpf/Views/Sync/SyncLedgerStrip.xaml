<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncLedgerStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:conv="clr-namespace:SpaceSnoop.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />

        <Style x:Key="TallyValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue}" />

        <Style x:Key="DirTally"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>

        <Style x:Key="DirTallyValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource Caption}" />

        <Style x:Key="LedgerStrip"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="MinHeight"
                    Value="44" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Setter Property="Opacity"
                    Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="8" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.24" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0"
                                                 Duration="0:0:0.30">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompositionSegment"
               TargetType="Rectangle">
            <Setter Property="Height"
                    Value="8" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="FreshIcon"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NewerIsLeft}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NewerIsRight}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FreshValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource TallyValue}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NewerIsLeft}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NewerIsRight}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanVolume"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="20,0,0,0" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPlanVolume}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanCopyPart"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPlanCopy}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanTrashPart"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPlanTrash}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NewerBadge"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="20,0,0,0" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Setter Property="Opacity"
                    Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowNewerBadge}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.24" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource LedgerStrip}"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource DiffSpectrumVertical}"
                    CornerRadius="10,0,0,10" />

            <WrapPanel Grid.Column="1"
                       Orientation="Horizontal"
                       VerticalAlignment="Center"
                       Margin="14,8,0,8">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource State.Success}" />
                    <TextBlock Text="ТОЛЬКО СЛЕВА"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding LeftOnlyCount}"
                               Style="{StaticResource TallyValue}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftOnlyDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding LeftOnlyDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource State.Info}" />
                    <TextBlock Text="ТОЛЬКО СПРАВА"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding RightOnlyCount}"
                               Style="{StaticResource TallyValue}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RightOnlyDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding RightOnlyDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource State.Warning}" />
                    <TextBlock Text="ИЗМЕНЕНЫ"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ModifiedCount}"
                               Style="{StaticResource TallyValue}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModifiedDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding ModifiedDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource State.Error}" />
                    <TextBlock Text="КОНФЛИКТЫ"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ConflictCount}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TallyValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConflicts}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource State.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource Border.Strong}" />
                    <TextBlock Text="ОДИНАКОВЫХ"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding IdenticalCount}"
                               Style="{StaticResource TallyValue}"
                               Foreground="{DynamicResource Fg.Muted}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdenticalDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding IdenticalDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource PlanVolume}"
                            ToolTip="{Binding PlanVolumeHint}">
                    <TextBlock Text="ОБЪЁМ"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <StackPanel Style="{StaticResource PlanCopyPart}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Copy}"
                                                  Width="11"
                                                  Height="11"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"
                                                  Foreground="{DynamicResource Accent.Primary}" />
                        <TextBlock Text="{Binding PlanCopyText}"
                                   Style="{StaticResource TallyValue}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource PlanTrashPart}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="11"
                                                  Height="11"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding PlanTrashText}"
                                   Style="{StaticResource TallyValue}"
                                   Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource NewerBadge}"
                            ToolTip="{Binding NewerBadgeTooltip}">
                    <iconPacks:PackIconLucide Kind="{Binding NewerBadgeIconKind}"
                                              Width="12"
                                              Height="12"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0"
                                              Style="{StaticResource FreshIcon}" />
                    <TextBlock Text="СВЕЖЕЕ"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding NewerBadgeText}"
                               Style="{StaticResource FreshValue}" />
                </StackPanel>
            </WrapPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0,14,0"
                        ToolTip="{Binding CompositionHint}">
                <TextBlock Text="СОСТАВ"
                           Style="{StaticResource Caption}"
                           Margin="0,0,10,0" />
                <Border x:Name="SyncCompositionTrack"
                        Width="184"
                        Height="8"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        ClipToBounds="True"
                        Background="{DynamicResource Bg.SurfaceMute}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource State.Success}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="LeftOnlyFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource State.Info}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="RightOnlyFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource State.Warning}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="ModifiedFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource State.Error}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="ConflictFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource Border.Strong}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="IdenticalFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
