<UserControl x:Class="SpaceSnoop.Wpf.Views.Sync.SyncLedgerStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Sync"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncLedgerViewModel}"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Sync/SyncLedgerStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border DataContext="{Binding Ledger}"
            Style="{StaticResource LedgerStrip}"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource DiffSpectrumVertical}"
                    CornerRadius="10,0,0,10" />

            <WrapPanel Grid.Column="1"
                       Orientation="Horizontal"
                       VerticalAlignment="Center"
                       Margin="14,8,0,8">
                <StackPanel Style="{StaticResource PlanVolume}"
                            ToolTip="{Binding PlanVolumeHint}">
                    <TextBlock Text="Объём"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <StackPanel Style="{StaticResource PlanCopyPart}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Copy}"
                                                  Width="11"
                                                  Height="11"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"
                                                  Foreground="{DynamicResource Accent.Primary}" />
                        <TextBlock Text="{Binding PlanCopyText}"
                                   Style="{StaticResource TallyValue}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource PlanTrashPart}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="11"
                                                  Height="11"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding PlanTrashText}"
                                   Style="{StaticResource TallyValue}"
                                   Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource NewerBadge}"
                            ToolTip="{Binding NewerBadgeTooltip}">
                    <iconPacks:PackIconLucide Kind="{Binding NewerBadgeIconKind}"
                                              Width="12"
                                              Height="12"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0"
                                              Style="{StaticResource FreshIcon}" />
                    <TextBlock Text="Свежее"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding NewerBadgeText}"
                               Style="{StaticResource FreshValue}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource Sync.LeftOnly}" />
                    <TextBlock Text="Только слева"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding LeftOnlyCount}"
                               Style="{StaticResource TallyValue}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftOnlyDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding LeftOnlyDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource State.Info}" />
                    <TextBlock Text="Только справа"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding RightOnlyCount}"
                               Style="{StaticResource TallyValue}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RightOnlyDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding RightOnlyDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource Sync.Modified}" />
                    <TextBlock Text="Изменены"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ModifiedCount}"
                               Style="{StaticResource TallyValue}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModifiedDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding ModifiedDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource ConflictTally}">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource State.Error}" />
                    <TextBlock Text="Конфликты"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ConflictCount}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TallyValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConflicts}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource State.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource Border.Strong}" />
                    <TextBlock Text="Одинаковых"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding IdenticalCount}"
                               Style="{StaticResource DirTallyValue}"
                               Foreground="{DynamicResource Fg.Muted}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"
                                   BasedOn="{StaticResource DirTally}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdenticalDirCount}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="{Binding IdenticalDirCount}"
                                   Style="{StaticResource DirTallyValue}" />
                    </StackPanel>
                </StackPanel>

            </WrapPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0,14,0"
                        ToolTip="{Binding CompositionHint}"
                        Visibility="{Binding HasDifferences, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Различия"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,7,0" />
                <TextBlock Text="{Binding DifferingTotal}"
                           Style="{StaticResource TallyValue}"
                           Margin="0,0,10,0" />
                <Border x:Name="SyncCompositionTrack"
                        Width="184"
                        Height="8"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        ClipToBounds="True"
                        Background="{DynamicResource Bg.SurfaceMute}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource Sync.LeftOnly}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="LeftOnlyFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource State.Info}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="RightOnlyFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource Sync.Modified}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="ModifiedFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Style="{StaticResource CompositionSegment}"
                                   Fill="{DynamicResource State.Error}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="ConflictFraction" />
                                    <Binding Path="ActualWidth"
                                             ElementName="SyncCompositionTrack" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
