<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:conv="clr-namespace:SpaceSnoop.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanInspectorViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="380">
    <UserControl.Resources>
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />
        <conv:HeatBrushConverter x:Key="HeatBrush" />

        <Style x:Key="Value"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue}">
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="FontWeight"
                    Value="Medium" />
        </Style>

        <Style x:Key="NodeIcon"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="14" />
            <Setter Property="Height"
                    Value="14" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Kind"
                    Value="File" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}"
                             Value="True">
                    <Setter Property="Kind"
                            Value="Folder" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectorAction"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Padding"
                    Value="8,6" />
            <Setter Property="Margin"
                    Value="0,2" />
        </Style>

        <Style x:Key="RailAction"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="7" />
            <Setter Property="MinHeight"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0,2" />
        </Style>

        <Style x:Key="RailSeparator"
               TargetType="Border">
            <Setter Property="Height"
                    Value="1" />
            <Setter Property="Width"
                    Value="20" />
            <Setter Property="Background"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="Margin"
                    Value="0,8" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}">
        <Grid>
            <StackPanel Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding ToggleInspectorCollapsedCommand}"
                        Padding="6,6"
                        ToolTip="Развернуть панель деталей"
                        AutomationProperties.Name="Развернуть панель деталей">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.PanelRightOpen}"
                                              Width="16"
                                              Height="16" />
                </Button>

                <TextBlock Text="Детали"
                           Style="{StaticResource Caption}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <TextBlock Text="{Binding TotalSizeText}"
                           Style="{StaticResource Value}"
                           Foreground="{DynamicResource Accent.Primary}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource RailSeparator}"
                            Margin="0,0,0,8" />

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding Node.OpenInExplorerCommand}"
                            ToolTip="Открыть в проводнике"
                            AutomationProperties.Name="Открыть в проводнике">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ExternalLink}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Info}" />
                    </Button>

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding Node.MarkDeletedCommand}"
                            ToolTip="Пометить на удаление"
                            AutomationProperties.Name="Пометить на удаление"
                            Visibility="{Binding Node.IsMarkedDeleted, Converter={StaticResource InverseBoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Error}" />
                    </Button>

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding Node.UnmarkDeletedCommand}"
                            ToolTip="Снять пометку на удаление"
                            AutomationProperties.Name="Снять пометку на удаление"
                            Visibility="{Binding Node.IsMarkedDeleted, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RotateCcw}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Success}" />
                    </Button>

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding Node.MarkContentsDeletedCommand}"
                            ToolTip="Пометить содержимое (папка останется)"
                            AutomationProperties.Name="Пометить содержимое"
                            Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderX}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Error}" />
                    </Button>

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding Node.UnmarkContentsCommand}"
                            ToolTip="Снять пометку с содержимого"
                            AutomationProperties.Name="Снять пометку с содержимого"
                            Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RotateCcw}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="{DynamicResource State.Success}" />
                    </Button>

                    <Border Style="{StaticResource RailSeparator}" />

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding CopyPathCommand}"
                            ToolTip="Копировать путь"
                            AutomationProperties.Name="Копировать путь">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Copy}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>

                    <Button Style="{StaticResource RailAction}"
                            Command="{Binding CopyDetailsCommand}"
                            ToolTip="Копировать детали"
                            AutomationProperties.Name="Копировать детали">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid Visibility="{Binding IsInspectorCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Height="{DynamicResource Control.Height.Default}"
                      Margin="14,12,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Детали"
                               Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ToggleInspectorCollapsedCommand}"
                            Padding="6"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            ToolTip="Свернуть панель деталей"
                            AutomationProperties.Name="Свернуть панель деталей">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.PanelRightClose}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>
                </Grid>

                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{DynamicResource Border.Subtle}" />

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="24"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.MousePointerClick}"
                                              Width="34"
                                              Height="34"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource Fg.Muted}"
                                              Opacity="0.7" />
                    <TextBlock Text="Ничего не выбрано"
                               Style="{StaticResource TextBlock.Heading}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="300"
                               Margin="0,12,0,0" />
                    <TextBlock Text="Кликните узел дерева – здесь появятся путь, размеры, доли и крупнейшие вложения."
                               Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="240"
                               Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="14,8,14,14"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Style="{StaticResource NodeIcon}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource TextBlock.Heading}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Title}" />
                        </StackPanel>

                        <Border Margin="0,8,0,0"
                                Padding="8,2"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Accent.Soft}"
                                CornerRadius="{DynamicResource Radius.Pill}">
                            <TextBlock Text="{Binding KindText}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Primary}" />
                        </Border>

                        <TextBlock Text="{Binding Path}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   ToolTip="{Binding Path}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Копировать путь"
                                              Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>

                        <Border Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Объём"
                                               Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalSizeText}"
                                               FontSize="{DynamicResource Font.Size.L}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent.Primary}" />
                                </Grid>
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding HasOwnSize, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Свои файлы"
                                               Style="{StaticResource Caption}"
                                               ToolTip="Файлы непосредственно в каталоге, без подкаталогов" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OwnSizeText}"
                                               Style="{StaticResource Value}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Visibility="{Binding HasShares, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,2"
                                      ToolTip="{Binding DriveShareHint}"
                                      Visibility="{Binding ShowDriveShare, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="От диска"
                                               Style="{StaticResource Caption}" />
                                    <Border x:Name="DriveBarTrack"
                                            Grid.Column="2"
                                            Height="10"
                                            Background="{DynamicResource Bg.SurfaceMute}"
                                            CornerRadius="{DynamicResource Radius.S}"
                                            VerticalAlignment="Center">
                                        <Rectangle HorizontalAlignment="Left"
                                                   Height="10"
                                                   RadiusX="4"
                                                   RadiusY="4">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="DriveShare" />
                                                    <Binding Path="ActualWidth"
                                                             ElementName="DriveBarTrack" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                            <Rectangle.Fill>
                                                <MultiBinding Converter="{StaticResource HeatBrush}">
                                                    <Binding Path="DriveShare" />
                                                    <Binding Path="Intensity" />
                                                </MultiBinding>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Border>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DriveShareText}"
                                               Style="{StaticResource Value}"
                                               MinWidth="42"
                                               Margin="8,0,0,0"
                                               TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2"
                                      Visibility="{Binding ShowParentShare, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="От родителя"
                                               Style="{StaticResource Caption}" />
                                    <Border x:Name="ParentBarTrack"
                                            Grid.Column="2"
                                            Height="10"
                                            Background="{DynamicResource Bg.SurfaceMute}"
                                            CornerRadius="{DynamicResource Radius.S}"
                                            VerticalAlignment="Center">
                                        <Rectangle HorizontalAlignment="Left"
                                                   Height="10"
                                                   RadiusX="4"
                                                   RadiusY="4">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="ShareOfParent" />
                                                    <Binding Path="ActualWidth"
                                                             ElementName="ParentBarTrack" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                            <Rectangle.Fill>
                                                <MultiBinding Converter="{StaticResource HeatBrush}">
                                                    <Binding Path="ShareOfParent" />
                                                    <Binding Path="Intensity" />
                                                </MultiBinding>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Border>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ShareOfParentText}"
                                               Style="{StaticResource Value}"
                                               MinWidth="42"
                                               Margin="8,0,0,0"
                                               TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,2"
                                      Visibility="{Binding ShowRootShare, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="От корня"
                                               Style="{StaticResource Caption}" />
                                    <Border x:Name="RootBarTrack"
                                            Grid.Column="2"
                                            Height="10"
                                            Background="{DynamicResource Bg.SurfaceMute}"
                                            CornerRadius="{DynamicResource Radius.S}"
                                            VerticalAlignment="Center">
                                        <Rectangle HorizontalAlignment="Left"
                                                   Height="10"
                                                   RadiusX="4"
                                                   RadiusY="4">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="ShareOfRoot" />
                                                    <Binding Path="ActualWidth"
                                                             ElementName="RootBarTrack" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                            <Rectangle.Fill>
                                                <MultiBinding Converter="{StaticResource HeatBrush}">
                                                    <Binding Path="ShareOfRoot" />
                                                    <Binding Path="Intensity" />
                                                </MultiBinding>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Border>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ShareOfRootText}"
                                               Style="{StaticResource Value}"
                                               MinWidth="42"
                                               Margin="8,0,0,0"
                                               TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Files}"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,7,0"
                                                              Foreground="{DynamicResource Fg.Muted}" />
                                    <StackPanel>
                                        <TextBlock Text="Файлов"
                                                   Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding FileCountText}"
                                                   Style="{StaticResource Value}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,7,0"
                                                              Foreground="{DynamicResource Fg.Muted}" />
                                    <StackPanel>
                                        <TextBlock Text="Каталогов"
                                                   Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding DirCountText}"
                                                   Style="{StaticResource Value}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Создан"
                                               Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CreationDateText}"
                                               Style="{StaticResource Value}"
                                               TextAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Доступ"
                                               Style="{StaticResource Caption}"
                                               ToolTip="Время последнего доступа" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LastAccessText}"
                                               Style="{StaticResource Value}"
                                               TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding HasTopChildren, Converter={StaticResource BoolToVisibility}}">
                            <Border BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Flame}"
                                                          Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,7,0"
                                                          Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Text="Крупнейшее"
                                           Style="{StaticResource SectionTitle}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding TopChildren}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3"
                                              ToolTip="{Binding ShareText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="ChildBarTrack"
                                                    Grid.Column="0"
                                                    Height="10"
                                                    Background="{DynamicResource Bg.SurfaceMute}"
                                                    CornerRadius="{DynamicResource Radius.S}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <Rectangle HorizontalAlignment="Left"
                                                           Height="10"
                                                           RadiusX="4"
                                                           RadiusY="4">
                                                    <Rectangle.Width>
                                                        <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                            <Binding Path="Fraction" />
                                                            <Binding Path="ActualWidth"
                                                                     ElementName="ChildBarTrack" />
                                                        </MultiBinding>
                                                    </Rectangle.Width>
                                                    <Rectangle.Fill>
                                                        <MultiBinding Converter="{StaticResource HeatBrush}">
                                                            <Binding Path="Fraction" />
                                                            <Binding Path="DataContext.Intensity"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Border>

                                            <iconPacks:PackIconLucide Grid.Column="1"
                                                                      Style="{StaticResource NodeIcon}"
                                                                      Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding SizeText}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       Foreground="{DynamicResource Fg.Primary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding MoreChildrenText}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasMoreChildren, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0,1,0,0"
                                Margin="0,14,0,8" />
                        <TextBlock Text="Действия"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding Node.OpenInExplorerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ExternalLink}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Foreground="{DynamicResource State.Info}" />
                                <TextBlock Text="Открыть в проводнике"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding Node.MarkDeletedCommand}"
                                ToolTip="Пометить узел и всё вложенное на удаление"
                                Visibility="{Binding Node.IsMarkedDeleted, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Foreground="{DynamicResource State.Error}" />
                                <TextBlock Text="Пометить на удаление"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding Node.UnmarkDeletedCommand}"
                                ToolTip="Снять пометку с узла и всего вложенного"
                                Visibility="{Binding Node.IsMarkedDeleted, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RotateCcw}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Foreground="{DynamicResource State.Success}" />
                                <TextBlock Text="Снять пометку на удаление"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding Node.MarkContentsDeletedCommand}"
                                ToolTip="Пометить на удаление всё вложенное; сама папка останется"
                                Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderX}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Foreground="{DynamicResource State.Error}" />
                                <TextBlock Text="Пометить содержимое"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding Node.UnmarkContentsCommand}"
                                ToolTip="Снять пометку со всего содержимого папки"
                                Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RotateCcw}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Foreground="{DynamicResource State.Success}" />
                                <TextBlock Text="Снять пометку с содержимого"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0,1,0,0"
                                Margin="0,8,0,8" />

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding CopyPathCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Copy}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                <TextBlock Text="Копировать путь"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource InspectorAction}"
                                Command="{Binding CopyDetailsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                <TextBlock Text="Копировать детали"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
