<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignWidth="980">
    <Border Style="{StaticResource Card.Inset}"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0"
                       VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding OpenPickerCommand}"
                        Margin="0,2,14,2"
                        MaxWidth="360"
                        Visibility="{Binding ShowScanResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        ToolTip="Выбрать другой диск или каталог"
                        AutomationProperties.Name="{Binding SelectedDrive, StringFormat='Цель сканирования: {0}. Выбрать другую'}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.HardDrive}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Foreground="{DynamicResource Fg.Secondary}" />
                        <TextBlock Text="{Binding SelectedDrive}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Font.Mono}" />
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ChevronDown}"
                                                  Width="13"
                                                  Height="13"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding StartCommand}"
                        Margin="0,2,0,2"
                        ToolTip="Посчитать занятое место в выбранном каталоге"
                        Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Play}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Сканировать" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding StopCommand}"
                        Margin="0,2,0,2"
                        ToolTip="Остановить сканирование (ESC)"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Square}"
                                                  Width="13"
                                                  Height="13"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Остановить" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">
                <Button Style="{StaticResource Button.Destructive}"
                        Command="{Binding Marks.DeleteMarkedCommand}"
                        ToolTip="{Binding Marks.DeleteHint}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Удалить"
                                   VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0"
                                Padding="6,0"
                                MinWidth="20"
                                Height="18"
                                VerticalAlignment="Center"
                                CornerRadius="{DynamicResource Radius.Pill}"
                                Background="#40FFFFFF"
                                Visibility="{Binding Marks.HasMarked, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Marks.MarkedCount}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Size.XS}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
