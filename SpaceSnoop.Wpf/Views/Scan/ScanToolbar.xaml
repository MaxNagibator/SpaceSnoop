<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignWidth="980">
    <Border>
        <Border.Style>
            <Style TargetType="Border"
                   BasedOn="{StaticResource Card.Inset}">
                <Setter Property="Padding"
                        Value="14,10" />
                <Setter Property="Margin"
                        Value="0,0,0,12" />
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                        Value="True">
                        <Setter Property="Padding"
                                Value="14,2" />
                        <Setter Property="Margin"
                                Value="0,0,0,6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0"
                       VerticalAlignment="Center">
                <Button Command="{Binding OpenPickerCommand}"
                        Margin="0,2,14,2"
                        Visibility="{Binding ShowScanResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        ToolTip="Выбрать другой диск или каталог"
                        AutomationProperties.Name="{Binding SelectedDrive, StringFormat='Цель сканирования: {0}. Выбрать другую'}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource Button.Secondary}">
                            <Setter Property="MaxWidth"
                                    Value="360" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                    Value="True">
                                    <Setter Property="MaxWidth"
                                            Value="320" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.HardDrive}"
                                                  Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Foreground="{DynamicResource Fg.Secondary}" />
                        <TextBlock Text="{Binding SelectedDrive}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Font.Mono}" />
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ChevronDown}"
                                                  Width="13"
                                                  Height="13"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </Button>

                <Button Margin="0,2,0,2">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource Button.Primary}">
                            <Setter Property="Command"
                                    Value="{Binding StartCommand}" />
                            <Setter Property="AutomationProperties.Name"
                                    Value="Сканировать" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}"
                                             Value="True">
                                    <Setter Property="Command"
                                            Value="{Binding StopCommand}" />
                                    <Setter Property="AutomationProperties.Name"
                                            Value="Остановить сканирование" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"
                                                Value="Посчитать занятое место в выбранном каталоге" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}"
                                                         Value="True">
                                                <Setter Property="Text"
                                                        Value="Остановить сканирование (Esc)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToolTip>
                    </Button.ToolTip>
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Play}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Сканировать" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Square}"
                                                      Width="13"
                                                      Height="13"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Остановить" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding ExportFullScanCommand}"
                        Margin="8,2,0,2"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        ToolTip="Сохранить полный результат сканирования в JSON"
                        AutomationProperties.Name="Сохранить полный результат сканирования">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FileBraces}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Сохранить скан"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                                            Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">
                <Button x:Name="ResetIgnoredButton"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding ResetIgnoredCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding HasIgnoredItems, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Снять все пометки игнорирования. Общая сводка сканирования включает игнорируемые элементы.">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Eye}"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ResetIgnoredCaption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Destructive}"
                        Command="{Binding Marks.DeleteMarkedCommand}"
                        ToolTip="{Binding Marks.DeleteHint}"
                        AutomationProperties.Name="{Binding Marks.MarkedCount, StringFormat='Удалить помеченное: {0}'}"
                        Visibility="{Binding Marks.HasMarked, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Marks.MarkedCount, StringFormat='Удалить ({0:N0})'}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
