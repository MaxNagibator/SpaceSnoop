<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanStructurePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:controls="clr-namespace:SpaceSnoop.Wpf.Views.Scan"
             xmlns:bootstrap="clr-namespace:SpaceSnoop.Wpf.Bootstrap"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}"
             d:DesignHeight="480"
             d:DesignWidth="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanNodeContextMenu.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanTreeRowTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanTreemapTooltip.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="{DynamicResource Control.Height.Default}"
                  Margin="10,6,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Структура каталога"
                               Style="{StaticResource SectionTitle}" />
                    <ListBox Style="{StaticResource ListBox.SegmentedCompact}"
                             ItemsSource="{Binding ViewModes}"
                             SelectedIndex="{Binding SelectedViewIndex}"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Вид структуры"
                             Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

                    <ToggleButton x:Name="HeatToggle"
                                  Style="{StaticResource ToggleButton.Toolbar}"
                                  Margin="6,0,0,0"
                                  MinWidth="34"
                                  Padding="0"
                                  ToolTip="Чувствительность тепловой подсветки"
                                  AutomationProperties.Name="Тепловая подсветка"
                                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Flame}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,10,0"
                            Visibility="{Binding TreeVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ComboBox.Toolbar}"
                              MinWidth="132"
                              Margin="0,0,6,0"
                              ToolTip="Поле сортировки строк дерева" />
                    <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                                  IsChecked="{Binding InvertSort}"
                                  MinWidth="34"
                                  Padding="0"
                                  ToolTip="Направление: отмечено – по убыванию, снято – по возрастанию"
                                  AutomationProperties.Name="Направление сортировки">
                        <iconPacks:PackIconLucide Width="15"
                                                  Height="15"
                                                  VerticalAlignment="Center">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Kind"
                                            Value="ArrowUpNarrowWide" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InvertSort}"
                                                     Value="True">
                                            <Setter Property="Kind"
                                                    Value="ArrowDownWideNarrow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                    </ToggleButton>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Файлы · доля · размер"
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding TreeVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

                <Popup x:Name="HeatPopup"
                       Grid.Column="0"
                       PlacementTarget="{Binding ElementName=HeatToggle}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=HeatToggle, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="6">
                    <Border Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="12"
                            MinWidth="260">
                        <StackPanel>
                            <TextBlock Text="Тепловая подсветка"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       Margin="0,0,0,8" />

                            <Border Height="8"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Background="{StaticResource HeatSpectrum}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="мягче"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />

                                <Slider x:Name="HeatSlider"
                                        Grid.Column="1"
                                        Minimum="{x:Static bootstrap:AppDefaults.IntensityMin}"
                                        Maximum="{x:Static bootstrap:AppDefaults.IntensityMax}"
                                        Value="{Binding Intensity}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="9,0,9,0"
                                        AutomationProperties.Name="Чувствительность тепловой подсветки" />

                                <TextBlock Grid.Column="2"
                                           Text="резче"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Intensity, StringFormat=0}"
                                           FontSize="{DynamicResource Font.Size.M}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Accent.Primary}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           MinWidth="18"
                                           TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource Border.Subtle}" />

            <TreeView Grid.Row="1"
                      ItemsSource="{Binding Roots}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="0,4,0,0"
                      Foreground="{DynamicResource Fg.Primary}"
                      PreviewMouseRightButtonDown="OnTreeRightButtonDown"
                      SelectedItemChanged="OnTreeSelectedItemChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemTemplate="{StaticResource ScanTreeRow}"
                      Visibility="{Binding TreeVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource TreeViewItem.Default}">
                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding"
                                Value="2,2" />
                        <Setter Property="ContextMenu"
                                Value="{StaticResource ScanNodeMenu}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <Grid Grid.Row="1"
                  Margin="0,4,0,0"
                  DataContext="{Binding Treemap}"
                  Visibility="{Binding DataContext.TreemapVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="10,2,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding TreemapBreadcrumbs}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide
                                        Kind="{x:Static iconPacks:PackIconLucideKind.ChevronRight}"
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Margin="1,0,1,0"
                                        Foreground="{DynamicResource Fg.Muted}"
                                        Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource Button.Ghost}"
                                            MinHeight="0"
                                            Padding="6,3"
                                            Content="{Binding Node.Name}"
                                            ToolTip="{Binding Node.AbsolutePath}"
                                            Command="{Binding DataContext.DrillToCrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Node}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TreemapTruncatedText}"
                               Style="{StaticResource Caption}"
                               Visibility="{Binding TreemapTruncated, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource Bg.SurfaceMute}"
                        CornerRadius="{DynamicResource Radius.S}"
                        ClipToBounds="True">
                    <Grid>
                        <controls:TreemapView x:Name="Treemap"
                                              ItemsSource="{Binding TreemapTiles}"
                                              Intensity="{Binding DataContext.Intensity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedNode, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              DrillCommand="{Binding DrillIntoCommand}"
                                              NodeContextMenu="{StaticResource ScanNodeMenu}"
                                              NodeTooltipTemplate="{StaticResource TreemapTooltip}"
                                              TooltipStyle="{StaticResource TreemapTooltipBeak}"
                                              Visibility="{Binding HasTreemapTiles, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasTreemapTiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Folder}"
                                                      Width="34"
                                                      Height="34"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Muted}"
                                                      Opacity="0.7" />
                            <TextBlock Text="Здесь пусто"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <controls:ScanDuplicatesPanel x:Name="Duplicates"
                                          Grid.Row="1"
                                          Margin="0,4,0,0"
                                          DataContext="{Binding Duplicates}"
                                          Visibility="{Binding DataContext.DuplicatesVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <keepshell:EmptyState Grid.Row="1"
                                  Icon="HardDrive"
                                  IconSize="40"
                                  Heading="Готовы к обзору диска"
                                  Description="Выберите диск или каталог и запустите сканирование – построим карту занятого места с тепловой подсветкой самых тяжёлых веток."
                                  DescriptionMaxWidth="440"
                                  ActionText="Выбрать каталог"
                                  ActionCommand="{Binding BrowseCommand}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Collapsed}" />
        </Grid>
    </Border>
</UserControl>
