<UserControl x:Class="SpaceSnoop.Wpf.Views.Scan.ScanSummaryStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Scan"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanSummaryViewModel}"
             d:DesignWidth="980">
    <UserControl.Resources>
        <Style x:Key="SummaryStrip"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Setter Property="Opacity"
                    Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="8" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.24" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0"
                                                 Duration="0:0:0.30">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsScanning}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource SummaryStrip}"
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource HeatSpectrumVertical}"
                    CornerRadius="10,0,0,10" />

            <WrapPanel Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="14,3,0,3">
                <WrapPanel.Resources>
                    <Style x:Key="Metric"
                           TargetType="StackPanel">
                        <Setter Property="Orientation"
                                Value="Horizontal" />
                        <Setter Property="Margin"
                                Value="0,4,20,0" />
                    </Style>
                </WrapPanel.Resources>

                <StackPanel Style="{StaticResource Metric}">
                    <TextBlock Text="Объём"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ResultSizeText}"
                               Style="{StaticResource StatValue.Lead}"
                               ToolTip="Логический объём учтённых файлов" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}">
                    <TextBlock Text="Файлов"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ResultFileCountText}"
                               Style="{StaticResource StatValue}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}">
                    <TextBlock Text="Каталогов"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ResultDirCountText}"
                               Style="{StaticResource StatValue}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}">
                    <TextBlock Text="Время"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ResultElapsedText}"
                               Style="{StaticResource StatValue.Aside}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}">
                    <TextBlock Text="Скорость"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ResultRateText}"
                               Style="{StaticResource StatValue.Aside}"
                               ToolTip="Средняя скорость обхода за время сканирования" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}"
                            Visibility="{Binding HasVolumeNote, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding VolumeNoteHint}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Info}"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource Fg.Muted}" />
                    <TextBlock Text="Сверх занятого"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding VolumeNote}"
                               Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource Fg.Secondary}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}"
                            Visibility="{Binding HasLinkNote, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding LinkNoteHint}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Link}"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource Fg.Muted}" />
                    <TextBlock Text="Не считано дважды"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding LinkNote}"
                               Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource Fg.Secondary}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Metric}"
                            Visibility="{Binding HasDropNote, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding DropNoteHint}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource State.Error}" />
                    <TextBlock Text="Нет в дереве"
                               Style="{StaticResource Caption}"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding DropNote}"
                               Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource State.Error}" />
                </StackPanel>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
