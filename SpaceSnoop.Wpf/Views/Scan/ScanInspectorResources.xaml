<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SpaceSnoop.Wpf;component/Views/Scan/ScanResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Value"
           TargetType="TextBlock"
           BasedOn="{StaticResource StatValue}">
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Setter Property="FontWeight"
                Value="Medium" />
    </Style>

    <Style x:Key="NodeIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width"
                Value="14" />
        <Setter Property="Height"
                Value="14" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Kind"
                Value="File" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirectory}"
                         Value="True">
                <Setter Property="Kind"
                        Value="Folder" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Fg.Secondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InspectorAction"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="8,6" />
        <Setter Property="Margin"
                Value="0,2" />
    </Style>

    <Style x:Key="RailAction"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="7" />
        <Setter Property="MinHeight"
                Value="0" />
        <Setter Property="Margin"
                Value="0,2" />
    </Style>

    <Style x:Key="RailSeparator"
           TargetType="Border">
        <Setter Property="Height"
                Value="1" />
        <Setter Property="Width"
                Value="20" />
        <Setter Property="Background"
                Value="{DynamicResource Border.Subtle}" />
        <Setter Property="Margin"
                Value="0,8" />
    </Style>
</ResourceDictionary>
