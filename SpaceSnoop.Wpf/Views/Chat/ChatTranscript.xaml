<UserControl x:Class="SpaceSnoop.Wpf.Views.Chat.ChatTranscript"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Behaviors"
             xmlns:chatvm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Chat"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance chatvm:ChatViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Chat/ChatResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Chat.Bubble"
                   TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MaxWidth" Value="720" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUser}"
                                 Value="True">
                        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsError}"
                                 Value="True">
                        <Setter Property="Background" Value="{DynamicResource State.ErrorSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Chat.BubbleRole"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource TextBlock.Subtle}">
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
                <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsError}"
                                 Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource State.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Chat.MessageAction"
                   TargetType="Button"
                   BasedOn="{StaticResource Button.Icon}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Chat.ActionIcon"
                   TargetType="iconPacks:PackIconLucide">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
            </Style>

            <Style x:Key="Chat.ToolBadge"
                   TargetType="Border"
                   BasedOn="{StaticResource Badge}">
                <Setter Property="Background" Value="{DynamicResource Bg.SurfaceMute}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg.Secondary}" />
                <Setter Property="TextElement.FontSize" Value="{DynamicResource Font.Size.Caption}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMutating}"
                                 Value="True">
                        <Setter Property="Background" Value="{DynamicResource State.WarningSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.Warning}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Chat.ToolBadgeIcon"
                   TargetType="iconPacks:PackIconLucide">
                <Setter Property="Width" Value="11" />
                <Setter Property="Height" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Kind" Value="{x:Static iconPacks:PackIconLucideKind.Wrench}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMutating}"
                                 Value="True">
                        <Setter Property="Kind" Value="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Chat.BubbleText"
                   TargetType="TextBox"
                   BasedOn="{StaticResource TextBox.Form}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsUser}" Value="True" />
                            <Condition Binding="{Binding HasText}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Chat.BubbleMarkdown"
                   TargetType="RichTextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="IsDocumentEnabled" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.M}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsUser}" Value="False" />
                            <Condition Binding="{Binding HasText}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,8"
                      Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}"
                      ScrollChanged="OnScrollChanged">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type chatvm:ChatMessageViewModel}">
                        <Grid Margin="16,10,16,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource Chat.Avatar}">
                                <iconPacks:PackIconLucide Style="{StaticResource Chat.AvatarIcon}" />
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Chat.Bubble}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource Chat.BubbleRole}"
                                                   Text="{Binding AuthorName}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <Button Style="{StaticResource Chat.MessageAction}"
                                                    Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Скопировать текст"
                                                    AutomationProperties.Name="Скопировать текст"
                                                    Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                                                <iconPacks:PackIconLucide Style="{StaticResource Chat.ActionIcon}"
                                                                          Kind="{x:Static iconPacks:PackIconLucideKind.Copy}" />
                                            </Button>

                                            <Button Style="{StaticResource Chat.MessageAction}"
                                                    Command="{Binding DataContext.RewindToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Вернуться к этому вопросу: всё, что после него, пропадёт, а текст вернётся в поле ввода"
                                                    AutomationProperties.Name="Вернуться к этому вопросу"
                                                    Visibility="{Binding CanRewind, Converter={StaticResource BoolToVisibility}}">
                                                <iconPacks:PackIconLucide Style="{StaticResource Chat.ActionIcon}"
                                                                          Kind="{x:Static iconPacks:PackIconLucideKind.Undo2}" />
                                            </Button>

                                            <Button Style="{StaticResource Chat.MessageAction}"
                                                    Command="{Binding DataContext.OpenTranscriptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Показать транскрипт хода – всё, что CLI прислал за этот ответ"
                                                    AutomationProperties.Name="Показать транскрипт хода"
                                                    Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                                                <iconPacks:PackIconLucide Style="{StaticResource Chat.ActionIcon}"
                                                                          Kind="{x:Static iconPacks:PackIconLucideKind.FileText}" />
                                            </Button>

                                            <Button Style="{StaticResource Chat.MessageAction}"
                                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Спросить ещё раз"
                                                    AutomationProperties.Name="Спросить ещё раз"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}">
                                                <iconPacks:PackIconLucide Style="{StaticResource Chat.ActionIcon}"
                                                                          Kind="{x:Static iconPacks:PackIconLucideKind.RotateCcw}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Style="{StaticResource Chat.BubbleText}"
                                             Text="{Binding Text, Mode=OneWay}" />

                                    <RichTextBox Style="{StaticResource Chat.BubbleMarkdown}"
                                                 behaviors:MarkdownText.Source="{Binding Text}" />

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,6,0,0"
                                                Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 Fill="{DynamicResource Accent.Primary}">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1"
                                                                             To="0.2"
                                                                             Duration="0:0:0.7"
                                                                             AutoReverse="True"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                                   FontSize="{DynamicResource Font.Size.S}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding StatusText}" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding ToolCalls}"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type chatvm:ChatToolCall}">
                                                <Border Style="{StaticResource Chat.ToolBadge}"
                                                        Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconLucide Style="{StaticResource Chat.ToolBadgeIcon}" />
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontSize="{DynamicResource Font.Size.Caption}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               Foreground="{DynamicResource State.Warning}"
                                               Margin="0,8,0,0"
                                               Text="Шнырь остановлен"
                                               Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               Foreground="{DynamicResource State.Warning}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Text="Ответ оборвался на полуслове – так его прислал сам CLI. Спросите ещё раз."
                                               Visibility="{Binding LooksTruncated, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               Margin="0,8,0,0"
                                               Text="{Binding UsageText}"
                                               Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="640"
                    Margin="24,0,24,24"
                    Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Style="{StaticResource Chat.HeroAvatar}">
                <iconPacks:PackIconLucide Width="28"
                                          Height="28"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Accent.Primary}"
                                          Kind="{x:Static iconPacks:PackIconLucideKind.Rat}" />
            </Border>

            <TextBlock Style="{StaticResource Chat.Headline}"
                       Text="{Binding AgentName}" />
            <TextBlock Style="{StaticResource Chat.Subhead}"
                       Text="{Binding Greeting}" />
            <TextBlock Style="{StaticResource Chat.Hint}"
                       Text="{Binding EmptyStateHint}" />

            <ItemsControl ItemsSource="{x:Static chatvm:ChatViewModel.Examples}"
                          Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type chatvm:ChatExample}">
                        <Button Style="{StaticResource Chat.ExampleCard}"
                                Command="{Binding DataContext.UseExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Text}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconLucide Grid.Column="0"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,10,0"
                                                          Foreground="{DynamicResource Accent.Primary}"
                                                          Kind="{Binding Icon}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fg.Primary}"
                                           FontWeight="{DynamicResource Font.Weight.Regular}"
                                           FontSize="{DynamicResource Font.Size.S}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
