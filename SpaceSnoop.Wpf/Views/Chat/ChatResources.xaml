<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style x:Key="Chat.HeroAvatar"
           TargetType="Border">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Chat.Avatar"
           TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Avatar}" />
        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUser}"
                         Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}"
                         Value="True">
                <Setter Property="Background" Value="{DynamicResource State.ErrorSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource State.Error}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chat.AvatarIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
        <Setter Property="Kind" Value="{x:Static iconPacks:PackIconLucideKind.Rat}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource State.Error}" />
                <Setter Property="Kind" Value="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chat.Headline"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.L}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,14,0,0" />
    </Style>

    <Style x:Key="Chat.Subhead"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.M}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="Chat.Hint"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="Chat.ExampleCard"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chat.HistoryItem"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}"
                                     Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chat.HistoryTitle"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Chat.HistorySubtitle"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Chat.HistoryDelete"
           TargetType="Button"
           BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.35" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chat.Placeholder"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
        <Setter Property="Margin" Value="12,9,12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Chat.Notice"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.SurfaceMute}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="Chat.NoticeText"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Chat.Selector"
           TargetType="ComboBox"
           BasedOn="{StaticResource ComboBox.Toolbar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style x:Key="Chat.NoticeIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
    </Style>

</ResourceDictionary>
