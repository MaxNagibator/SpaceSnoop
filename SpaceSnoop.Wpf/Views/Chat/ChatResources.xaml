<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style x:Key="Chat.HeroIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
    </Style>

    <Style x:Key="Chat.Headline"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.L}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="Chat.Hint"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

</ResourceDictionary>
