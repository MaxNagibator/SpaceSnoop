<UserControl x:Class="SpaceSnoop.Wpf.Views.Chat.ChatComposer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chatvm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Chat"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance chatvm:ChatViewModel}"
             d:DesignWidth="900">

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
        <StackPanel>
            <Border Background="{DynamicResource State.WarningSoft}"
                    BorderBrush="{DynamicResource State.Warning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="10,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding MutationsAllowed, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Grid.Column="0"
                                              Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                              Width="15"
                                              Height="15"
                                              VerticalAlignment="Top"
                                              Margin="0,1,8,0"
                                              Foreground="{DynamicResource State.Warning}" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               Text="Изменяющие операции разрешены в настройках: агент может сам запустить синхронизацию – файлы скопируются, лишние уйдут в корзину. Сначала он обязан показать план и дождаться вашего согласия." />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Input"
                         Grid.Column="0"
                         Style="{StaticResource TextBox.Form}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="OnInputPreviewKeyDown" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,0">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding NewConversationCommand}"
                            ToolTip="Новый разговор"
                            AutomationProperties.Name="Новый разговор">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.SquarePen}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>

                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CancelCommand}"
                            ToolTip="Остановить"
                            AutomationProperties.Name="Остановить"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Square}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>

                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding SendCommand}"
                            ToolTip="Отправить (Enter)"
                            AutomationProperties.Name="Отправить"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Send}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                            <TextBlock Text="Отправить"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,6,0,0"
                       Text="Enter – отправить, Shift+Enter – перенос строки" />
        </StackPanel>
    </Border>
</UserControl>
