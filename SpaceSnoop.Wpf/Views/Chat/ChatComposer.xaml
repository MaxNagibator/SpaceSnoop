<UserControl x:Class="SpaceSnoop.Wpf.Views.Chat.ChatComposer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chatvm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Chat"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance chatvm:ChatViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Chat/ChatResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
        <StackPanel>
            <Border Style="{StaticResource Chat.Notice}"
                    Margin="0,0,0,10"
                    ToolTip="{Binding MutationsNotice}"
                    Visibility="{Binding MutationsAllowed, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Style="{StaticResource Chat.NoticeIcon}"
                                              Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}" />
                    <TextBlock Style="{StaticResource Chat.NoticeText}"
                               Text="{Binding MutationsNoticeShort}" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="Input"
                             Style="{StaticResource TextBox.Form}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="OnInputPreviewKeyDown" />

                    <TextBlock Style="{StaticResource Chat.Placeholder}"
                               Text="{Binding InputPlaceholder}"
                               Visibility="{Binding Text, ElementName=Input, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,0">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding ToggleHistoryCommand}"
                            ToolTip="{Binding HistoryToggleHint}"
                            AutomationProperties.Name="{Binding HistoryToggleHint}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.PanelLeft}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>

                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding NewConversationCommand}"
                            ToolTip="Новый разговор"
                            AutomationProperties.Name="Новый разговор"
                            Margin="8,0,0,0">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.SquarePen}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>

                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CancelCommand}"
                            ToolTip="Остановить"
                            AutomationProperties.Name="Остановить"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Square}"
                                                  Width="16"
                                                  Height="16" />
                    </Button>

                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding SendCommand}"
                            ToolTip="Отправить (Enter)"
                            AutomationProperties.Name="Отправить"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Send}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                            <TextBlock Text="Отправить"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Style="{StaticResource Chat.Selector}"
                          ItemsSource="{Binding AgentModel.ModelOptions}"
                          SelectedItem="{Binding AgentModel.SelectedModel, Mode=TwoWay}"
                          ToolTip="Модель агента – применяется со следующего сообщения"
                          AutomationProperties.Name="Модель агента">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       ToolTip="{Binding Hint}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="1"
                          Style="{StaticResource Chat.Selector}"
                          ItemsSource="{Binding AgentModel.EffortOptions}"
                          SelectedItem="{Binding AgentModel.SelectedEffort, Mode=TwoWay}"
                          Margin="4,0,0,0"
                          ToolTip="Глубина рассуждений – чем выше, тем дольше и дороже ответ"
                          AutomationProperties.Name="Глубина рассуждений" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.S}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Text="Enter – отправить, Shift+Enter – перенос строки" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
