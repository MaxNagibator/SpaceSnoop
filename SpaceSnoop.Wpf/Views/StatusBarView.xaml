<UserControl x:Class="SpaceSnoop.Wpf.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:views="clr-namespace:SpaceSnoop.Wpf.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="32"
             d:DesignWidth="1100">
    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0">
        <Grid Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0">
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           Visibility="{Binding CurrentPageStatus.IsBusy, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible, TargetNullValue=Visible}" />
                <TextBlock Text="{Binding CurrentPageStatus.StatusCaption}"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="520"
                           ToolTip="{Binding CurrentPageStatus.StatusCaption}"
                           Visibility="{Binding CurrentPageStatus.IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
            </StackPanel>

            <views:PerformanceHudView Grid.Column="1"
                                      DataContext="{Binding Hud}"
                                      VerticalAlignment="Center"
                                      Margin="6,0,14,0" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="14,0"
                        Visibility="{Binding CurrentPageStatus.IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding CurrentPageStatus.CancelCommand}"
                        Padding="8,2"
                        MinHeight="22"
                        VerticalAlignment="Center"
                        ToolTip="Отменить операцию"
                        AutomationProperties.Name="Отменить операцию"
                        Visibility="{Binding CurrentPageStatus.CancelCommand, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                  Width="12"
                                                  Height="12"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Отменить"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
