<UserControl x:Class="SpaceSnoop.Wpf.Views.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignHeight="36"
             d:DesignWidth="1100">

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            ClipToBounds="True"
            keepshell:TitleBarBehavior.IsWindowChrome="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <keepshell:ThemeChromeHost Part="TitleBarBackdrop"
                                       Grid.ColumnSpan="2" />

            <keepshell:ThemeChromeHost Part="TitleBarOrnament"
                                       Grid.Column="0"
                                       Margin="0,0,18,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" />

            <Grid Grid.Column="0"
                  Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/SpaceSnoop.Wpf;component/icon.ico"
                       Width="18"
                       Height="18"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1"
                           Text="SpaceSnoop"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Style="{StaticResource TextBlock.Subtle}">
                    <Run Text="v" /><Run Text="{Binding AppVersion, Mode=OneTime}" />
                </TextBlock>

                <keepshell:FirstFitPanel x:Name="ElevationSlot"
                                     Grid.Column="3"
                                     Margin="14,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                    <Border x:Name="ElevationPill"
                            Padding="8,2"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="Режим запуска приложения">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ShieldCheck}"
                                                      Width="13"
                                                      Height="13"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}" />
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Shield}"
                                                      Width="13"
                                                      Height="13"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="{Binding ElevationCaption}"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       VerticalAlignment="Center" />
                            <Button Content="Перезапустить от администратора"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding RestartAsAdminCommand}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Margin="10,0,0,0"
                                    Padding="6,2"
                                    MinHeight="22"
                                    VerticalAlignment="Center"
                                    ToolTip="Перезапустить приложение с правами администратора"
                                    AutomationProperties.Name="Перезапустить от имени администратора"
                                    Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="ElevationIcon"
                          VerticalAlignment="Center">
                        <Button x:Name="ElevationIconButton"
                                Style="{StaticResource Theme.SegmentButton}"
                                Command="{Binding RestartAsAdminCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                Width="30"
                                MinHeight="24"
                                ToolTip="Обычный режим: часть каталогов не прочитать. Нажмите, чтобы перезапустить от администратора"
                                AutomationProperties.Name="Перезапустить от имени администратора"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Shield}"
                                                      Width="14"
                                                      Height="14" />
                        </Button>
                        <Border Width="30"
                                MinHeight="24"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                Background="Transparent"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Запущено от администратора"
                                AutomationProperties.Name="Запущено от администратора"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ShieldCheck}"
                                                      Width="14"
                                                      Height="14"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Secondary}" />
                        </Border>
                    </Grid>
                </keepshell:FirstFitPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <Border Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent.Primary}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        Padding="2,1"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Visibility="{Binding AppUpdate.HasPendingUpdate, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource Theme.SegmentButton}"
                                Command="{Binding AppUpdate.ShowDetailsCommand}"
                                Padding="5,4,4,4"
                                MinHeight="24"
                                VerticalAlignment="Center"
                                ToolTip="Открыть окно установки обновления"
                                AutomationProperties.Name="Доступно обновление приложения">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Sparkles}"
                                                          Width="14"
                                                          Height="14"
                                                          Foreground="{DynamicResource Accent.Text}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="{Binding AppUpdate.PillText}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg.Primary}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Theme.SegmentButton}"
                                Command="{Binding AppUpdate.DismissCommand}"
                                Padding="4,4"
                                MinHeight="24"
                                VerticalAlignment="Center"
                                ToolTip="Скрыть для этой версии"
                                AutomationProperties.Name="Скрыть уведомление об обновлении">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                      Width="12"
                                                      Height="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Fg.Secondary}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource Theme.SegmentButton}"
                        Command="{Binding PageRefreshCommand}"
                        Width="36"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="{Binding CurrentPageRefresh.RefreshTooltip, FallbackValue=Перезагрузить страницу, TargetNullValue=Перезагрузить страницу}"
                        AutomationProperties.Name="Перезагрузить страницу"
                        Visibility="{Binding CurrentPageRefresh, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RotateCcw}"
                                              Width="16"
                                              Height="16" />
                </Button>
                <Border Width="1"
                        Background="{DynamicResource Border.Subtle}"
                        Margin="0,8,8,8"
                        Visibility="{Binding CurrentPageRefresh, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />

                <keepshell:ThemeSwitcher DataContext="{Binding Theme}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                <Border Width="1"
                        Background="{DynamicResource Border.Subtle}"
                        Margin="0,8" />
                <Button Style="{StaticResource Chrome.Button}"
                        keepshell:ChromeAction.Action="Minimize"
                        ToolTip="Свернуть"
                        AutomationProperties.Name="Свернуть окно">
                    <Path Style="{StaticResource Chrome.Glyph.Minimize}" />
                </Button>
                <Button Style="{StaticResource Chrome.Button.MaxRestore}"
                        keepshell:ChromeAction.Action="MaxRestore">
                    <Path Style="{StaticResource Chrome.Glyph.MaxRestore}" />
                </Button>
                <Button Style="{StaticResource Chrome.Button.Close}"
                        keepshell:ChromeAction.Action="Close"
                        ToolTip="Закрыть"
                        AutomationProperties.Name="Закрыть окно">
                    <Path Style="{StaticResource Chrome.Glyph.Close}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
