<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style x:Key="RowGlyph"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width"
                Value="14" />
        <Setter Property="Height"
                Value="14" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,9,0" />
        <Setter Property="Kind"
                Value="File" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirectory}"
                         Value="True">
                <Setter Property="Kind"
                        Value="Folder" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}"
                         Value="Deleting">
                <Setter Property="Kind"
                        Value="LoaderCircle" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Accent.Text}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}"
                               Value="Deleting" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="RowGlyphSpin">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                             From="0"
                                             To="360"
                                             Duration="0:0:1.1"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="RowGlyphSpin" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding State}"
                         Value="Done">
                <Setter Property="Kind"
                        Value="CircleCheck" />
                <Setter Property="Foreground"
                        Value="{DynamicResource State.SuccessText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}"
                         Value="Failed">
                <Setter Property="Kind"
                        Value="CircleX" />
                <Setter Property="Foreground"
                        Value="{DynamicResource State.ErrorText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowParent"
           TargetType="TextBlock">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="10,0,0,0" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
    </Style>

    <Style x:Key="RowPath"
           TargetType="TextBlock">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Secondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}"
                         Value="Done">
                <Setter Property="Foreground"
                        Value="{DynamicResource Fg.Muted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}"
                         Value="Failed">
                <Setter Property="Foreground"
                        Value="{DynamicResource State.ErrorText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowError"
           TargetType="TextBlock">
        <Setter Property="Margin"
                Value="0,1,0,0" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground"
                Value="{DynamicResource State.ErrorText}" />
    </Style>

    <Style x:Key="RowModeBadge"
           TargetType="Border"
           BasedOn="{StaticResource Badge}">
        <Setter Property="Margin"
                Value="10,0,0,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Background"
                Value="{DynamicResource Bg.SurfaceMute}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Border.Subtle}" />
        <Setter Property="TextElement.Foreground"
                Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="TextElement.FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPermanent}"
                         Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource State.ErrorSoft}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource State.Error}" />
                <Setter Property="TextElement.Foreground"
                        Value="{DynamicResource State.ErrorText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
