<UserControl x:Class="SpaceSnoop.Wpf.Views.Dialogs.FileDiffDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:diff="clr-namespace:SpaceSnoop.Wpf.Diff"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FileDiffDialogViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="980"
             Width="980"
             MinHeight="560">

    <UserControl.Resources>
        <!-- TODO: фиксированные тинты — в теме нет subtle-фон токенов для +/−; апгрейд на токены KeepShell, если появятся -->
        <SolidColorBrush x:Key="Diff.AddedBg"
                         Color="#3327C93F" />
        <SolidColorBrush x:Key="Diff.RemovedBg"
                         Color="#33F04438" />
        <SolidColorBrush x:Key="Diff.EmptyBg"
                         Color="#14808080" />

        <Style x:Key="DiffNum"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="4,0,8,0" />
        </Style>

        <Style x:Key="DiffText"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="Padding"
                    Value="2,0,8,0" />
        </Style>

        <Style x:Key="DiffSign"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Added">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Removed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UnifiedCell"
               TargetType="Border">
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Added">
                    <Setter Property="Background"
                            Value="{StaticResource Diff.AddedBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="Removed">
                    <Setter Property="Background"
                            Value="{StaticResource Diff.RemovedBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeftCell"
               TargetType="Border">
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LeftKind}"
                             Value="Removed">
                    <Setter Property="Background"
                            Value="{StaticResource Diff.RemovedBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LeftKind}"
                             Value="None">
                    <Setter Property="Background"
                            Value="{StaticResource Diff.EmptyBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightCell"
               TargetType="Border">
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RightKind}"
                             Value="Added">
                    <Setter Property="Background"
                            Value="{StaticResource Diff.AddedBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RightKind}"
                             Value="None">
                    <Setter Property="Background"
                            Value="{StaticResource Diff.EmptyBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiffRowContainer"
               TargetType="ListBoxItem">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="MinHeight"
                    Value="20" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitCompareArrows}"
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Foreground="{DynamicResource State.Info}" />
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource TextBlock.Heading}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Added, StringFormat=+{0}}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource State.Success}" />
                    <TextBlock Text="{Binding Removed, StringFormat=−{0}}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource State.Error}" />
                </StackPanel>
                <TextBlock Text="Файлы идентичны"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           Visibility="{Binding HasChanges, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding ToggleCollapseAllCommand}"
                        MinWidth="0"
                        Padding="9,0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        ToolTip="Развернуть или свернуть все неизменные области"
                        AutomationProperties.Name="{Binding CollapseAllText}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{Binding CollapseAllIconKind}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CollapseAllText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                              IsChecked="{Binding Unified}"
                              MinWidth="0"
                              Padding="9,0"
                              VerticalAlignment="Center"
                              ToolTip="Объединённый вид (unified diff)"
                              AutomationProperties.Name="Объединённый вид">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Rows3}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Объединённый"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding LeftPath}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding LeftPath}" />
            <iconPacks:PackIconLucide Grid.Column="1"
                                      Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                      Width="13"
                                      Height="13"
                                      VerticalAlignment="Center"
                                      Margin="10,0"
                                      Foreground="{DynamicResource Fg.Muted}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding RightPath}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding RightPath}" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,14,0,0"
              Visibility="{Binding Unified, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Text="ЛЕВАЯ"
                       Style="{StaticResource Caption}"
                       Margin="2,0,0,0" />
            <TextBlock Grid.Column="4"
                       Text="ПРАВАЯ"
                       Style="{StaticResource Caption}"
                       Margin="2,0,0,0" />
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource Card.Inset}"
                Padding="0"
                Margin="0,6,0,0">
            <ListBox ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,4"
                     Foreground="{DynamicResource Fg.Primary}"
                     ItemContainerStyle="{StaticResource DiffRowContainer}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type diff:DiffRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource LeftCell}" />
                            <Border Grid.Column="3"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource RightCell}" />

                            <TextBlock Grid.Column="0"
                                       Text="{Binding LeftNumberText}"
                                       Style="{StaticResource DiffNum}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LeftText}"
                                       Style="{StaticResource DiffText}"
                                       ToolTip="{Binding LeftText}" />
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Border.Subtle}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding RightNumberText}"
                                       Style="{StaticResource DiffNum}" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding RightText}"
                                       Style="{StaticResource DiffText}"
                                       ToolTip="{Binding RightText}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type diff:DiffLine}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Style="{StaticResource UnifiedCell}" />

                            <TextBlock Grid.Column="0"
                                       Text="{Binding LeftNumberText}"
                                       Style="{StaticResource DiffNum}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RightNumberText}"
                                       Style="{StaticResource DiffNum}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Sign}"
                                       Style="{StaticResource DiffSign}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Text}"
                                       Style="{StaticResource DiffText}"
                                       ToolTip="{Binding Text}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type diff:DiffGap}">
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,3"
                                Command="{Binding DataContext.ExpandGapCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="Показать скрытые строки">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.UnfoldVertical}"
                                                          Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"
                                                          Foreground="{DynamicResource Fg.Muted}" />
                                <TextBlock Text="{Binding Count, StringFormat='Скрыто строк: {0}'}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Fg.Muted}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,18,0,0">
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding CloseCommand}"
                    Content="Закрыть"
                    MinWidth="96"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    Padding="16,6"
                    IsDefault="True"
                    IsCancel="True" />
        </Grid>
    </Grid>
</UserControl>
