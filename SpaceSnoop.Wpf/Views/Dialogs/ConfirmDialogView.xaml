<UserControl x:Class="SpaceSnoop.Wpf.Views.Dialogs.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Dialogs"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ConfirmDialogViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="620"
             Width="{DynamicResource Dialog.Width.Medium}">

    <UserControl.Resources>
        <Style x:Key="Confirm.Line"
               TargetType="TextBlock">
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}"
                             Value="">
                    <Setter Property="Height"
                            Value="8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Confirm.Dismissive"
               TargetType="Button"
               BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
        <Style x:Key="Confirm.Secondary"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
        <Style x:Key="Confirm.Primary"
               TargetType="Button"
               BasedOn="{StaticResource Button.Primary}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="16,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
        <Style x:Key="Confirm.Destructive"
               TargetType="Button"
               BasedOn="{StaticResource Button.Destructive}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="16,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="{Binding IconKind}"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource Accent.Primary}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TextBlock.Heading}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card.Inset}"
                Padding="12,10"
                Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource Confirm.Line}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                      Width="16"
                                      Height="16"
                                      VerticalAlignment="Top"
                                      Margin="0,2,8,0"
                                      Foreground="{DynamicResource State.Error}" />
            <TextBlock Text="{Binding Warning}"
                       TextWrapping="Wrap"
                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                       Foreground="{DynamicResource State.Error}" />
        </StackPanel>

        <ItemsControl Grid.Row="3"
                      Margin="0,14,0,0"
                      ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Button Style="{StaticResource Confirm.Dismissive}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsDismissive, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Confirm.Secondary}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsSecondary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Confirm.Primary}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Confirm.Destructive}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
