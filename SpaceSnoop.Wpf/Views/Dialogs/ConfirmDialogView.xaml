<UserControl x:Class="SpaceSnoop.Wpf.Views.Dialogs.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Dialogs"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ConfirmDialogViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="620"
             Width="{DynamicResource Dialog.Width.Medium}">

    <UserControl.Resources>
        <Style x:Key="Confirm.Text"
               TargetType="TextBlock">
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Margin"
                    Value="0,0,0,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmTextTone.Muted}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmTextTone.Strong}">
                    <Setter Property="FontWeight"
                            Value="{DynamicResource Font.Weight.SemiBold}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmTextTone.Danger}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Confirm.Metric.Caption"
               TargetType="TextBlock">
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmMetricTone.Sub}">
                    <Setter Property="Margin"
                            Value="18,0,0,0" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmMetricTone.Danger}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Confirm.Metric.Value"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="16,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmMetricTone.Sub}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}"
                             Value="{x:Static vm:ConfirmMetricTone.Danger}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:ConfirmTextLine}">
            <TextBlock Text="{Binding Body}"
                       Style="{StaticResource Confirm.Text}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmMetricLine}">
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="Confirm.Count" />
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="Confirm.Size" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Caption}"
                           Style="{StaticResource Confirm.Metric.Caption}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Count}"
                           Style="{StaticResource Confirm.Metric.Value}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Size}"
                           Style="{StaticResource Confirm.Metric.Value}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmGapLine}">
            <Border Height="8" />
        </DataTemplate>

        <Style x:Key="Confirm.Dismissive"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
        <Style x:Key="Confirm.Secondary"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
        <Style x:Key="Confirm.Primary"
               TargetType="Button"
               BasedOn="{StaticResource Button.Primary}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="16,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
        <Style x:Key="Confirm.Destructive"
               TargetType="Button"
               BasedOn="{StaticResource Button.Destructive}">
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Control.Height.Default}" />
            <Setter Property="Padding"
                    Value="16,6" />
            <Setter Property="Margin"
                    Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconLucide Grid.Column="0"
                                      Kind="{Binding IconKind}"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource Accent.Primary}" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource TextBlock.Heading}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Secondary}"
                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource Card.Inset}"
                Padding="12,10"
                Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lines}"
                              Grid.IsSharedSizeScope="True" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,12,0,0"
              Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconLucide Grid.Column="0"
                                      Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                      Width="16"
                                      Height="16"
                                      VerticalAlignment="Top"
                                      Margin="0,2,8,0"
                                      AutomationProperties.Name="Предупреждение"
                                      Foreground="{DynamicResource State.Error}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Warning}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Font.Size.S}"
                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                       Foreground="{DynamicResource State.Error}" />
        </Grid>

        <ItemsControl Grid.Row="3"
                      Margin="0,14,0,0"
                      ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Button Style="{StaticResource Confirm.Dismissive}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsDismissive, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Confirm.Secondary}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsSecondary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Confirm.Primary}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Confirm.Destructive}"
                                Content="{Binding Caption}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
