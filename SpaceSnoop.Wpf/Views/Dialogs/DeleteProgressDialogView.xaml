<UserControl x:Class="SpaceSnoop.Wpf.Views.Dialogs.DeleteProgressDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Dialogs"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:behaviors="clr-namespace:SpaceSnoop.Wpf.Views.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DeleteProgressDialogViewModel}"
             d:DesignHeight="520"
             d:DesignWidth="640"
             Width="{DynamicResource Dialog.Width.Medium}"
             MinHeight="260"
             AutomationProperties.Name="{Binding Title}">

    <UserControl.Resources>
        <Style x:Key="RowGlyph"
               TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width"
                    Value="14" />
            <Setter Property="Height"
                    Value="14" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,9,0" />
            <Setter Property="Kind"
                    Value="File" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}"
                             Value="True">
                    <Setter Property="Kind"
                            Value="Folder" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Deleting">
                    <Setter Property="Kind"
                            Value="LoaderCircle" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Done">
                    <Setter Property="Kind"
                            Value="CircleCheck" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Failed">
                    <Setter Property="Kind"
                            Value="CircleX" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowParent"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="10,0,0,0" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
        </Style>

        <Style x:Key="RowPath"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="Done">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Failed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                      Width="20"
                                      Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource State.Error}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource DialogTitle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,10,0,0">
            <TextBlock Text="{Binding IntroText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding IsIdle, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource Card.Inset}"
                Padding="6"
                Margin="0,14,0,0"
                MinHeight="88">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}"
                              Grid.IsSharedSizeScope="True"
                              AutomationProperties.Name="Помеченные объекты">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,3"
                                  ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto"
                                                      SharedSizeGroup="RowSize" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconLucide Grid.Column="0"
                                                          Style="{StaticResource RowGlyph}" />

                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource RowPath}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ParentPath}"
                                               Style="{StaticResource RowParent}" />
                                </Grid>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeText}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,2,0"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Fg.Muted}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    Visibility="{Binding IsIdle, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Height="8"
                             VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="1"
                             AutomationProperties.Name="Ход удаления"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CountText}"
                           AutomationProperties.Name="Удалено объектов"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Size.S}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Accent.Primary}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           behaviors:PathTrimmer.FullPath="{Binding CurrentPath}"
                           AutomationProperties.Name="Текущий объект"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Muted}"
                           ToolTip="{Binding CurrentPath}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBlock Text="Освобождено"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"
                               FontFamily="{DynamicResource Font.Sans}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg.Muted}" />
                    <TextBlock Text="{Binding FreedText}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Accent.Primary}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="4"
              Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CloseCommand}"
                        Content="Отмена"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Style="{StaticResource Button.Destructive}"
                        Command="{Binding StartCommand}"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="16,6"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Удалить" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CancelRunCommand}"
                        Content="Отменить удаление"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="14,6" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding CloseCommand}"
                        Content="Закрыть"
                        MinWidth="96"
                        MinHeight="{DynamicResource Control.Height.Default}"
                        Padding="16,6"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
