<UserControl x:Class="SpaceSnoop.Wpf.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels"
             xmlns:conv="clr-namespace:SpaceSnoop.Wpf.Converters"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SyncViewModel}"
             d:DesignHeight="680"
             d:DesignWidth="1040">

    <UserControl.Resources>
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />

        <Style x:Key="TallyValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue}" />

        <Style x:Key="EndpointChip"
               TargetType="Border">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="CornerRadius"
                    Value="11" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="NodeName"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}"
                             Value="True">
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="LeftOnly">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="RightOnly">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Modified">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Conflict">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Identical">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NodeNameLeft"
               TargetType="TextBlock"
               BasedOn="{StaticResource NodeName}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LeftAbsent}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="TextDecorations"
                            Value="Strikethrough" />
                    <Setter Property="FontWeight"
                            Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NodeNameRight"
               TargetType="TextBlock"
               BasedOn="{StaticResource NodeName}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RightAbsent}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="TextDecorations"
                            Value="Strikethrough" />
                    <Setter Property="FontWeight"
                            Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChevronToggle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Width"
                    Value="14" />
            <Setter Property="Height"
                    Value="14" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name"
                    Value="Развернуть или свернуть каталог" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChevronBd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.S}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ChevronBd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SyncNodeMenu">
            <ContextMenu.Resources>
                <Style x:Key="MenuGlyph"
                       TargetType="iconPacks:PackIconLucide">
                    <Setter Property="Width"
                            Value="14" />
                    <Setter Property="Height"
                            Value="14" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                    <Setter Property="Margin"
                            Value="0,0,9,0" />
                </Style>
            </ContextMenu.Resources>

            <MenuItem
                Command="{Binding PlacementTarget.DataContext.CopyToRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsFile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                  Foreground="{DynamicResource State.Success}" />
                        <TextBlock Text="Копировать →"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.CopyToLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsFile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                  Foreground="{DynamicResource State.Info}" />
                        <TextBlock Text="← Копировать"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsFile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Пропустить"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsFile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                                  Foreground="{DynamicResource State.Error}" />
                        <TextBlock Text="Удалить"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirCopyToRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                  Foreground="{DynamicResource State.Success}" />
                        <TextBlock Text="Всё копировать →"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirCopyToLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                  Foreground="{DynamicResource State.Info}" />
                        <TextBlock Text="← Всё копировать"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirSkipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.IsDirectory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Style="{StaticResource MenuGlyph}"
                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Всё пропустить"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{Binding PlacementTarget.DataContext.DirDeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Header="{Binding PlacementTarget.DataContext.DirDeleteHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Visibility="{Binding PlacementTarget.DataContext.CanDirDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Icon>
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                              Width="14"
                                              Height="14"
                                              Foreground="{DynamicResource State.Error}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="DiffRow"
               TargetType="ListBoxItem">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="Padding"
                    Value="6,1" />
            <Setter Property="MinHeight"
                    Value="26" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="ContextMenu"
                    Value="{StaticResource SyncNodeMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="RowBd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="RowBd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="RowBd"
                                        Property="BorderThickness"
                                        Value="0,1,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Bg.SurfaceMute}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionPill"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Default}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Width"
                    Value="34" />
            <Setter Property="Height"
                    Value="24" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Pill}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceMute}" />
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Action}"
                             Value="CopyToRight">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="CopyToLeft">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="DeleteLeft">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="DeleteRight">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}"
                             Value="None">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideSize"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="MinWidth"
                    Value="56" />
        </Style>

        <Style x:Key="LedgerStrip"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Setter Property="Opacity"
                    Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="8" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.24" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0"
                                                 Duration="0:0:0.30">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompositionSegment"
               TargetType="Rectangle">
            <Setter Property="Height"
                    Value="8" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card.Inset}"
                Padding="14,12"
                Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Rectangle Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="0"
                               Width="2"
                               HorizontalAlignment="Center"
                               Margin="0,17,0,17"
                               Fill="{DynamicResource Border.Default}" />

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource EndpointChip}"
                            Background="{DynamicResource State.SuccessSoft}"
                            BorderBrush="{DynamicResource State.Success}"
                            ToolTip="Левая сторона">
                        <TextBlock Text="Л"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource State.Success}" />
                    </Border>

                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Accent.Soft}"
                            BorderBrush="{DynamicResource Accent.Primary}"
                            ToolTip="Направление синхронизации">
                        <iconPacks:PackIconLucide Kind="{Binding DirectionIconKind}"
                                                  Width="11"
                                                  Height="11"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Accent.Primary}" />
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource EndpointChip}"
                            Background="{DynamicResource State.InfoSoft}"
                            BorderBrush="{DynamicResource State.Info}"
                            ToolTip="Правая сторона">
                        <TextBlock Text="П"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource State.Info}" />
                    </Border>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Toolbar}"
                             Margin="10,0,8,4"
                             ToolTip="Каталог слева" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding BrowseLeftCommand}"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Обзор" />
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Toolbar}"
                             Margin="10,4,8,0"
                             ToolTip="Каталог справа" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding BrowseRightCommand}"
                            Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.FolderOpen}"
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Обзор" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding CompareCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitCompare}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Сравнить" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding HashCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Сверить изменённые файлы по содержимому">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Fingerprint}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Хеши" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding SyncCommand}"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRightLeft}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Синхронизировать" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Padding="6,3"
                                CornerRadius="{DynamicResource Radius.M}"
                                Background="{DynamicResource Bg.Surface}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                ToolTip="Разрешить все спорные элементы разом">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.GitMerge}"
                                                          Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Center"
                                                          Margin="2,0,8,0"
                                                          Foreground="{DynamicResource Fg.Muted}" />
                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding ResolveAllToRightCommand}"
                                        Padding="9,2"
                                        MinHeight="26"
                                        Foreground="{DynamicResource State.Success}"
                                        ToolTip="Все спорные — слева направо"
                                        AutomationProperties.Name="Все спорные — слева направо">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowRight}"
                                                              Width="14"
                                                              Height="14" />
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding ResolveAllToLeftCommand}"
                                        Padding="9,2"
                                        MinHeight="26"
                                        Foreground="{DynamicResource State.Info}"
                                        ToolTip="Все спорные — справа налево"
                                        AutomationProperties.Name="Все спорные — справа налево">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ArrowLeft}"
                                                              Width="14"
                                                              Height="14" />
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding ResolveAllSkipCommand}"
                                        Padding="9,2"
                                        MinHeight="26"
                                        ToolTip="Пропустить все спорные"
                                        AutomationProperties.Name="Пропустить все спорные">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Ban}"
                                                              Width="14"
                                                              Height="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Modes}"
                                  SelectedIndex="{Binding SelectedModeIndex}"
                                  Style="{StaticResource ComboBox.Toolbar}"
                                  MinWidth="172"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  ToolTip="Направление синхронизации" />
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Funnel}"
                                                  Width="13"
                                                  Height="13"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Исключения"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Style="{StaticResource TextBlock.Subtle}" />
                        <TextBox Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Toolbar}"
                                 Width="200"
                                 VerticalAlignment="Center"
                                 ToolTip="Глоб-шаблоны через запятую, напр. bin,obj,*.tmp" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox Content="Показывать одинаковые"
                                  IsChecked="{Binding ShowIdentical}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Размеры"
                                  IsChecked="{Binding ShowSizes}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource LedgerStrip}"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource DiffSpectrumVertical}"
                        CornerRadius="10,0,0,10" />

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="14,8,0,8">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource State.Success}" />
                        <TextBlock Text="ТОЛЬКО СЛЕВА"
                                   Style="{StaticResource Caption}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="{Binding LeftOnlyCount}"
                                   Style="{StaticResource TallyValue}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource State.Info}" />
                        <TextBlock Text="ТОЛЬКО СПРАВА"
                                   Style="{StaticResource Caption}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="{Binding RightOnlyCount}"
                                   Style="{StaticResource TallyValue}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource State.Warning}" />
                        <TextBlock Text="ИЗМЕНЕНЫ"
                                   Style="{StaticResource Caption}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ModifiedCount}"
                                   Style="{StaticResource TallyValue}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource State.Error}" />
                        <TextBlock Text="КОНФЛИКТЫ"
                                   Style="{StaticResource Caption}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ConflictCount}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource TallyValue}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConflicts}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource State.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource Border.Strong}" />
                        <TextBlock Text="ОДИНАКОВЫХ"
                                   Style="{StaticResource Caption}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="{Binding IdenticalCount}"
                                   Style="{StaticResource TallyValue}"
                                   Foreground="{DynamicResource Fg.Muted}" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,14,0">
                    <TextBlock Text="СОСТАВ"
                               Style="{StaticResource Caption}"
                               Margin="0,0,10,0" />
                    <Border x:Name="SyncCompositionTrack"
                            Width="184"
                            Height="8"
                            CornerRadius="{DynamicResource Radius.Pill}"
                            ClipToBounds="True"
                            Background="{DynamicResource Bg.SurfaceMute}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource CompositionSegment}"
                                       Fill="{DynamicResource State.Success}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                        <Binding Path="LeftOnlyFraction" />
                                        <Binding Path="ActualWidth"
                                                 ElementName="SyncCompositionTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <Rectangle Style="{StaticResource CompositionSegment}"
                                       Fill="{DynamicResource State.Info}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                        <Binding Path="RightOnlyFraction" />
                                        <Binding Path="ActualWidth"
                                                 ElementName="SyncCompositionTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <Rectangle Style="{StaticResource CompositionSegment}"
                                       Fill="{DynamicResource State.Warning}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                        <Binding Path="ModifiedFraction" />
                                        <Binding Path="ActualWidth"
                                                 ElementName="SyncCompositionTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <Rectangle Style="{StaticResource CompositionSegment}"
                                       Fill="{DynamicResource State.Error}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                        <Binding Path="ConflictFraction" />
                                        <Binding Path="ActualWidth"
                                                 ElementName="SyncCompositionTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                            <Rectangle Style="{StaticResource CompositionSegment}"
                                       Fill="{DynamicResource Border.Strong}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                        <Binding Path="IdenticalFraction" />
                                        <Binding Path="ActualWidth"
                                                 ElementName="SyncCompositionTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="14,6,18,8"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="0,0,8,0">
                        <TextBlock Text="ЛЕВАЯ"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="РАЗМЕР"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding ShowSizes, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="ДЕЙСТВИЕ"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" />

                    <Grid Grid.Column="2"
                          Margin="8,0,0,0">
                        <TextBlock Text="ПРАВАЯ"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="РАЗМЕР"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding ShowSizes, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>

                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{DynamicResource Border.Subtle}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,4,0,0"
                         Foreground="{DynamicResource Fg.Primary}"
                         ItemContainerStyle="{StaticResource DiffRow}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Margin="{Binding IndentMargin}"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ChevronToggle}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="{Binding ExpandIconKind}"
                                                                  Width="12"
                                                                  Height="12" />
                                    </Button>
                                    <iconPacks:PackIconLucide Grid.Column="1"
                                                              Style="{StaticResource NodeIcon}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               Style="{StaticResource NodeNameLeft}" />
                                    <iconPacks:PackIconLucide Grid.Column="3"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                              Width="12"
                                                              Height="12"
                                                              VerticalAlignment="Center"
                                                              Margin="4,0,4,0"
                                                              Foreground="{DynamicResource State.Error}"
                                                              ToolTip="Конфликт — требуется разрешение">
                                        <iconPacks:PackIconLucide.Style>
                                            <Style TargetType="iconPacks:PackIconLucide">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Conflict">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconLucide.Style>
                                    </iconPacks:PackIconLucide>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding LeftSizeText}"
                                               Style="{StaticResource SideSize}"
                                               Margin="8,0,6,0"
                                               Visibility="{Binding DataContext.ShowSizes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionPill}"
                                        Command="{Binding CycleActionCommand}"
                                        IsEnabled="{Binding CanCycle}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ToolTip="{Binding ActionHint}"
                                        AutomationProperties.Name="{Binding ActionHint}"
                                        Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconLucide Kind="{Binding ActionIconKind}"
                                                              Width="15"
                                                              Height="15" />
                                </Button>

                                <Grid Grid.Column="2"
                                      Margin="{Binding IndentMargin}"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ChevronToggle}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="{Binding ExpandIconKind}"
                                                                  Width="12"
                                                                  Height="12" />
                                    </Button>
                                    <iconPacks:PackIconLucide Grid.Column="1"
                                                              Style="{StaticResource NodeIcon}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               Style="{StaticResource NodeNameRight}" />
                                    <iconPacks:PackIconLucide Grid.Column="3"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                              Width="12"
                                                              Height="12"
                                                              VerticalAlignment="Center"
                                                              Margin="4,0,4,0"
                                                              Foreground="{DynamicResource State.Error}"
                                                              ToolTip="Конфликт — требуется разрешение">
                                        <iconPacks:PackIconLucide.Style>
                                            <Style TargetType="iconPacks:PackIconLucide">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Conflict">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconLucide.Style>
                                    </iconPacks:PackIconLucide>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding RightSizeText}"
                                               Style="{StaticResource SideSize}"
                                               Margin="8,0,6,0"
                                               Visibility="{Binding DataContext.ShowSizes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <keepshell:EmptyState Grid.Row="1"
                                      Icon="GitCompareArrows"
                                      IconSize="40"
                                      Heading="Сравнение ещё не выполнялось"
                                      Description="Укажите два каталога — слева и справа — выберите направление и нажмите «Сравнить». Различия лягут в дерево с цветовой кодировкой статуса и направленными действиями синхронизации."
                                      DescriptionMaxWidth="460"
                                      ActionText="Сравнить"
                                      ActionCommand="{Binding CompareCommand}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}" />

                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        Padding="10,5">
                    <TextBlock Text="{Binding SummaryText}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               Foreground="{DynamicResource Fg.Muted}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
