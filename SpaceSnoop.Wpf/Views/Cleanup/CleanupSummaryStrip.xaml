<UserControl x:Class="SpaceSnoop.Wpf.Views.Cleanup.CleanupSummaryStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Cleanup"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanupViewModel}">

    <Border BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="0,10,0,0">
        <keepshell:UniformRowPanel>
            <WrapPanel VerticalAlignment="Center">

                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Найдено"
                               Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding TotalText}"
                               Style="{StaticResource StatValue}"
                               FontSize="{DynamicResource Font.Size.L}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Выбрано"
                               Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedText}"
                               FontSize="{DynamicResource Font.Size.L}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource StatValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedBytes}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Accent.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

            </WrapPanel>
            <Button HorizontalAlignment="Right"
                    Margin="0,4,0,4"
                    Style="{StaticResource Button.Base}"
                    Command="{Binding CleanSelectedCommand}"
                    VerticalAlignment="Center"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    Padding="16,6"
                    ToolTip="Файлы удаляются безвозвратно, мимо корзины">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource State.ErrorText}" />
                    <TextBlock Text="Очистить выбранное" />
                </StackPanel>
            </Button>
        </keepshell:UniformRowPanel>
    </Border>
</UserControl>
