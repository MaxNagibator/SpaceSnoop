<UserControl x:Class="SpaceSnoop.Wpf.Views.Cleanup.CleanupSummaryStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpaceSnoop.Wpf.ViewModels.Cleanup"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanupViewModel}">

    <Border Style="{StaticResource Card}"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,28,0">
                <TextBlock Text="НАЙДЕНО"
                           Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding TotalText}"
                           Style="{StaticResource TextBlock.Mono}"
                           FontSize="{DynamicResource Font.Size.L}"
                           Foreground="{DynamicResource Fg.Primary}" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="ВЫБРАНО"
                           Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding SelectedText}"
                           Style="{StaticResource TextBlock.Mono}"
                           FontSize="{DynamicResource Font.Size.L}"
                           Foreground="{DynamicResource Accent.Primary}" />
            </StackPanel>

            <Button Grid.Column="3"
                    Style="{StaticResource Button.Destructive}"
                    Command="{Binding CleanSelectedCommand}"
                    VerticalAlignment="Center"
                    MinHeight="{DynamicResource Control.Height.Default}"
                    Padding="16,6"
                    ToolTip="Файлы удаляются безвозвратно, мимо корзины">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Trash2}"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0" />
                    <TextBlock Text="Очистить выбранное" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
