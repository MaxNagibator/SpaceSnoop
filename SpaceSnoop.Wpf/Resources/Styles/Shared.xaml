<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style x:Key="Caption"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Sans}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="SectionTitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Sans}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.M}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="DialogTitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.XL}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="StatValue"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Sans}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.M}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
    </Style>

    <Style x:Key="NodeIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width"
                Value="14" />
        <Setter Property="Height"
                Value="14" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,8,0" />
        <Setter Property="Kind"
                Value="File" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirectory}"
                         Value="True">
                <Setter Property="Kind"
                        Value="Folder" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Accent.Primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Color x:Key="Heat.Color0">#E0C9C1</Color>
    <Color x:Key="Heat.Color1">#CE9886</Color>
    <Color x:Key="Heat.Color2">#BB6C52</Color>
    <Color x:Key="Heat.Color3">#A84625</Color>

    <SolidColorBrush x:Key="Sync.LeftOnly"
                     Color="{StaticResource Heat.Color3}" />

    <SolidColorBrush x:Key="Sync.Modified"
                     Color="{StaticResource Heat.Color1}" />

    <SolidColorBrush x:Key="Diff.RemovedBg"
                     Color="#38A84625" />

    <SolidColorBrush x:Key="Diff.AddedBg"
                     Color="#4D6E8CA8" />

    <SolidColorBrush x:Key="Diff.RemovedStrong"
                     Color="#70A84625" />

    <SolidColorBrush x:Key="Diff.AddedStrong"
                     Color="#856E8CA8" />

    <SolidColorBrush x:Key="Diff.EmptyBg"
                     Color="#14808080" />

    <LinearGradientBrush x:Key="HeatSpectrum"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Offset="0"
                      Color="{StaticResource Heat.Color0}" />
        <GradientStop Offset="0.33"
                      Color="{StaticResource Heat.Color1}" />
        <GradientStop Offset="0.66"
                      Color="{StaticResource Heat.Color2}" />
        <GradientStop Offset="1"
                      Color="{StaticResource Heat.Color3}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeatSpectrumVertical"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Offset="0"
                      Color="{StaticResource Heat.Color3}" />
        <GradientStop Offset="0.33"
                      Color="{StaticResource Heat.Color2}" />
        <GradientStop Offset="0.66"
                      Color="{StaticResource Heat.Color1}" />
        <GradientStop Offset="1"
                      Color="{StaticResource Heat.Color0}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DiffSpectrumVertical"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Offset="0"
                      Color="{StaticResource Heat.Color3}" />
        <GradientStop Offset="0.34"
                      Color="#93A6BA" />
        <GradientStop Offset="0.67"
                      Color="{StaticResource Heat.Color1}" />
        <GradientStop Offset="1"
                      Color="#E07878" />
    </LinearGradientBrush>

</ResourceDictionary>
